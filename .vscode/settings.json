{
    "chat.tools.terminal.autoApprove": {
        "robocopy": true,
        "/^uv run poe test 2>&1$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^uv run pytest tests/ -q$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^uv run ruff check src/ ; uv run pytest tests/ -q$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^uv run ruff check --fix src/ ; uv run ruff check src/ ; uv run pytest tests/ -q$/": {
            "approve": true,
            "matchCommandLine": true
        }
    }
}