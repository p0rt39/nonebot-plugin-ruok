<div id="notifications-container">
{% if rules %}
<div class="table-scroll">
<table class="striped">
    <thead>
        <tr>
            <th>规则</th>
            <th>状态</th>
            <th>触发状态</th>
            <th>适用模块</th>
            <th>冷却</th>
            <th>通道</th>
        </tr>
    </thead>
    <tbody>
        {% for rule in rules %}
        <tr class="notification-card">
            <td>
                <strong>
                    <a href="/ruok/notifications/{{ rule.name | _path_quote }}">{{ rule.name }}</a>
                </strong>
            </td>
            <td class="cell-nowrap">
                <span class="badge badge-{{ 'ok' if rule.enabled else 'muted' }}">
                    {{ '启用' if rule.enabled else '禁用' }}
                </span>
            </td>
            <td>
                {% for s in rule.on_status %}
                <span class="badge badge-{{ s | _status_tone }}">{{ s | _status_label }}</span>
                {% endfor %}
            </td>
            <td style="overflow-wrap:anywhere;">
                {{ rule.on_module | join(', ') if rule.on_module else '全部' }}
            </td>
            <td class="cell-nowrap">{{ rule.cooldown_minutes | round(1) }} 分钟</td>
            <td style="overflow-wrap:anywhere;">
                {{ rule.channels | join(', ') }}
                {% if rule.webhook_url %}<br><small class="muted-text">{{ rule.webhook_url }}</small>{% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
</div>
{% else %}
<article>
    <p>暂无通知规则。使用上方的“新建规则”添加。</p>
</article>
{% endif %}
</div>
