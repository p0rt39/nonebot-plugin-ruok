{% extends "base.html.jinja2" %}
{% set active_page = "modules" %}
{% block title %}{{ module.display_name or module.name }} — 模块详情{% endblock %}

{% block content %}

<article class="hero-banner {% if module.status == 'available' %}ok{% elif module.status == 'degraded' %}warn{% elif module.status == 'unavailable' %}error{% endif %}">
    <div class="status-bar__main">
        <strong class="status-bar__title">{{ module.display_name or module.name }}</strong>
        <span class="badge badge-{{ module.status | _status_tone }}">{{ module.status | _status_label }}</span>
        <span class="status-bar__sub">{{ module.name }}</span>
    </div>
    {% if module.description %}
    <p class="status-bar__desc">{{ module.description }}</p>
    {% endif %}
    {% if module.status_reasons %}
    <ul class="status-bar__reasons">
        {% for reason in module.status_reasons %}
        <li>{{ reason }}</li>
        {% endfor %}
    </ul>
    {% endif %}
</article>

<!-- Actions -->
<div class="ruok-button-row" style="margin-bottom:0.9rem;">
    <a href="/ruok/modules" role="button" class="secondary outline ruok-button-compact">← 返回模块列表</a>
    <form hx-post="/ruok/_actions/module-delete"
          hx-target="body"
          hx-swap="none"
          hx-confirm="确定删除模块「{{ module.display_name or module.name }}」？"
          style="margin:0;">
        <input type="hidden" name="name" value="{{ module.name }}">
        <input type="hidden" name="redirect_to" value="/ruok/modules">
        <button type="submit" class="secondary outline ruok-button-danger">删除模块</button>
    </form>
</div>

<!-- Edit Module -->
{% include "_module_form.html.jinja2" %}

<!-- Linked Plugins -->
<h4>关联插件</h4>
{% if linked_plugins %}
<div class="table-scroll">
<table>
    <thead><tr><th>插件</th><th>健康提示</th><th>说明</th></tr></thead>
    <tbody>
    {% for p in linked_plugins %}
    <tr>
        <td><strong>{{ p.name }}</strong></td>
        <td class="cell-muted">{{ p.health_hint }}</td>
        <td>{{ p.metadata.description if p.metadata and p.metadata.description else '—' }}</td>
    </tr>
    {% endfor %}
    </tbody>
</table>
</div>
{% else %}
<p class="muted-text">未关联插件</p>
{% endif %}

<!-- Sessions -->
<h4>相关 Sessions ({{ sessions | length }})</h4>
{% include "_sessions_list.html.jinja2" %}

{% endblock %}
