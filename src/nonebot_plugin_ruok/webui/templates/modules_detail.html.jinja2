{% extends "base.html.jinja2" %}
{% set active_page = "modules" %}
{% block title %}{{ module.display_name or module.name }} — 模块详情{% endblock %}

{% block content %}

<article class="hero-banner {% if module.status == 'available' %}ok{% elif module.status == 'degraded' %}warn{% else %}error{% endif %}"
         style="margin-bottom:1.5rem;">
    <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap;">
        <span style="font-size:2em;">
            {% if module.status == 'available' %}🟢
            {% elif module.status == 'degraded' %}🟡
            {% elif module.status == 'unavailable' %}🔴
            {% else %}⚪{% endif %}
        </span>
        <div>
            <h3 style="margin:0;">{{ module.display_name or module.name }}</h3>
            <small style="opacity:0.7;">{{ module.name }} · {{ module.status }}</small>
        </div>
    </div>
    {% if module.description %}
    <p style="margin-top:0.75rem;opacity:0.85;">{{ module.description }}</p>
    {% endif %}
</article>

<!-- Linked Plugins -->
{% if linked_plugins %}
<h4>🔌 关联插件</h4>
<div class="grid" style="margin-bottom:1.5rem;">
    {% for p in linked_plugins %}
    <article style="padding:0.6rem 1rem;">
        <strong>{{ p.name }}</strong>
        <small style="float:right;opacity:0.7;">{{ p.health_hint }}</small>
        {% if p.metadata and p.metadata.description %}
        <p style="margin:0.25rem 0 0;font-size:0.85em;">{{ p.metadata.description }}</p>
        {% endif %}
    </article>
    {% endfor %}
</div>
{% else %}
<p style="opacity:0.6;">⚠️ 未关联插件</p>
{% endif %}

<!-- Sessions -->
<h4>📋 Sessions ({{ sessions | length }})</h4>
{% include "_sessions_list.html.jinja2" %}

<!-- Actions -->
<div style="margin-top:2rem;display:flex;gap:0.5rem;">
    <a href="/ruok/modules" role="button" class="secondary outline">Back to Modules</a>
</div>

{% endblock %}
