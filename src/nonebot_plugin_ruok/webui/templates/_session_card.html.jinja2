<!-- HTMX partial: one Session row (list rendering and list action responses) -->
{% set summary = s.description | _session_summary %}
<div id="session-{{ s.session_id }}" class="session-row">
    <div class="session-row__status">
        <span class="badge badge-{{ s.status | _status_tone }}">{{ s.status | _status_label }}</span>
    </div>
    <div class="session-row__id">
        <a href="/ruok/sessions/{{ s.session_id }}" title="查看详情">{{ s.session_id }}</a>
    </div>
    <div class="session-row__module" title="{{ s.module_name }}">{{ s.module_name }}</div>
    <div class="session-row__summary">
        <span class="session-row__text" title="{{ summary }}">{{ summary or '（无描述）' }}</span>
        {% if s.reporter.user_id or s.affected_plugins or s.link_group %}
        <span class="session-row__meta">
            {% if s.reporter.user_id %}
            {% set reporter_label = reporter_display(s.reporter) if reporter_display is defined else s.reporter.user_id %}
            上报者: {{ reporter_label }}{% if s.reporter.group_id %} (群: {{ s.reporter.group_id }}){% endif %}
            {% endif %}
            {% if s.affected_plugins %}{% if s.reporter.user_id %} · {% endif %}影响插件: {{ s.affected_plugins | join(', ') }}{% endif %}
            {% if s.link_group %} · 关联组 <code>{{ s.link_group }}</code>{% endif %}
        </span>
        {% endif %}
    </div>
    <div class="session-row__time">
        {{ s.last_seen_at.astimezone().strftime('%m-%d %H:%M') }}<br>
        <small>{{ s.source }}</small>
    </div>
    <div class="session-row__actions">{% if s.status in ('pending', 'unsolved') %}
        <div class="ruok-button-row--grid">
            {% set plugin_options = session_plugin_options(s.module_name) if session_plugin_options is defined else [] %}
            {% if s.status == 'pending' or plugin_options or s.affected_plugins %}
            <form hx-post="/ruok/_actions/confirm/{{ s.session_id }}"
                  hx-target="#session-{{ s.session_id }}"
                  hx-swap="outerHTML">
                {% if plugin_options %}
                <details class="confirm-plugin-picker">
                    <summary role="button" class="secondary outline">
                        {% if s.status == 'pending' %}✅ 确认{% else %}🧩 修改插件{% endif %}
                    </summary>
                    <div class="confirm-plugin-options">
                        {% for plugin in plugin_options %}
                        <label>
                            <input type="checkbox" name="affected_plugins" value="{{ plugin }}"
                                   {% if plugin in s.affected_plugins %}checked{% endif %}>
                            {{ plugin }}
                        </label>
                        {% endfor %}
                        <button type="submit" class="secondary outline ruok-button">
                            {% if s.status == 'pending' %}确认 Session{% else %}保存插件关联{% endif %}
                        </button>
                    </div>
                </details>
                {% elif s.status == 'unsolved' and s.affected_plugins %}
                <button type="submit" class="secondary outline">🧹 清空插件</button>
                {% else %}
                <button type="submit" class="secondary outline">✅ 确认</button>
                {% endif %}
            </form>
            {% endif %}
            <button class="secondary outline"
                    hx-post="/ruok/_actions/solve/{{ s.session_id }}"
                    hx-target="#session-{{ s.session_id }}"
                    hx-swap="outerHTML">
                解决
            </button>
            <button class="secondary outline ruok-button-danger"
                    hx-post="/ruok/_actions/ignore/{{ s.session_id }}"
                    hx-target="#session-{{ s.session_id }}"
                    hx-swap="outerHTML"
                    hx-confirm="确定将 {{ s.session_id }} 标记为误报并忽略？">
                忽略
            </button>
        </div>
    {% endif %}</div>
</div>
