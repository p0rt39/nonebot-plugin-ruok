{% set current_module = module | default(none) %}
<details open style="margin-bottom:1.5rem;">
    <summary>{% if current_module %}✏️ 编辑模块{% else %}➕ 添加模块{% endif %}</summary>
    <form hx-post="/ruok/_actions/module-upsert"
          {% if current_module %}hx-target="#module-edit-result" hx-swap="innerHTML"{% else %}hx-target="#module-list" hx-swap="outerHTML"{% endif %}
          style="margin-top:1rem;">
        {% if current_module %}
        <input type="hidden" name="original_name" value="{{ current_module.name }}">
        <input type="hidden" name="return_to_detail" value="true">
        {% endif %}
        <div class="grid">
            <label>
                模块名
                <input type="text" name="name" required
                       value="{{ current_module.name if current_module else '' }}"
                       placeholder="e.g. weather">
            </label>
            <label>
                显示名
                <input type="text" name="display_name"
                       value="{{ current_module.display_name if current_module else '' }}"
                       placeholder="天气插件">
            </label>
        </div>
        <label>
            描述
            <input type="text" name="description"
                   value="{{ current_module.description or '' if current_module else '' }}"
                   placeholder="可选描述">
        </label>
        <fieldset>
            <legend>已加载插件</legend>
            {% if all_plugins %}
            <datalist id="module-plugin-options">
                {% for p in all_plugins %}
                <option value="{{ p }}"></option>
                {% endfor %}
            </datalist>
            <div class="ruok-picker" data-field-name="selected_plugins">
                <div class="ruok-picker-controls">
                    <input type="search"
                           placeholder="搜索插件名"
                           list="module-plugin-options"
                           data-picker-input>
                    <button type="button"
                            class="outline secondary"
                            title="添加插件"
                            aria-label="添加插件"
                            data-picker-add>+</button>
                </div>
                <div class="ruok-picker-list" data-picker-list>
                    {% if current_module %}
                    {% for p in current_module.plugins if p in all_plugins %}
                    <span class="ruok-picker-chip" data-picker-value="{{ p }}">
                        <span>{{ p }}</span>
                        <input type="hidden" name="selected_plugins" value="{{ p }}">
                        <button type="button"
                                class="outline secondary ruok-picker-remove"
                                title="移除 {{ p }}"
                                aria-label="移除 {{ p }}"
                                data-picker-remove>&times;</button>
                    </span>
                    {% endfor %}
                    {% endif %}
                </div>
            </div>
            {% else %}
            <input type="text" disabled value="暂无已加载插件">
            {% endif %}
        </fieldset>
        <label>
            其他插件名 (逗号或换行分隔)
            <textarea name="plugins" rows="3"
                      placeholder="nonebot_plugin_weather, nonebot_plugin_scheduler">{{ extra_plugins | default([]) | join(',') }}</textarea>
        </label>
        <div class="ruok-button-row">
            <button type="submit" class="ruok-button">保存模块</button>
            {% if current_module %}
            <button type="button" class="outline secondary ruok-button"
                    hx-get="/ruok/_actions/module-edit-form?{{ {'name': current_module.name} | urlencode }}"
                    hx-target="closest details"
                    hx-swap="outerHTML">
                取消
            </button>
            {% endif %}
        </div>
        <div id="module-edit-result"></div>
    </form>
</details>
