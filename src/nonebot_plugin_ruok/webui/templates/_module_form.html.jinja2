{% set current_module = module | default(none) %}
<details open style="margin-bottom:1.5rem;">
    <summary>{% if current_module %}✏️ 编辑模块{% else %}➕ 添加模块{% endif %}</summary>
    <form hx-post="/ruok/_actions/module-upsert"
          {% if current_module %}hx-target="#module-edit-result" hx-swap="innerHTML"{% else %}hx-target="#module-list" hx-swap="outerHTML"{% endif %}
          style="margin-top:1rem;">
        {% if current_module %}
        <input type="hidden" name="original_name" value="{{ current_module.name }}">
        <input type="hidden" name="return_to_detail" value="true">
        {% endif %}
        <div class="grid">
            <label>
                模块名
                <input type="text" name="name" required
                       value="{{ current_module.name if current_module else '' }}"
                       placeholder="e.g. weather">
            </label>
            <label>
                显示名
                <input type="text" name="display_name"
                       value="{{ current_module.display_name if current_module else '' }}"
                       placeholder="天气插件">
            </label>
        </div>
        <label>
            描述
            <input type="text" name="description"
                   value="{{ current_module.description or '' if current_module else '' }}"
                   placeholder="可选描述">
        </label>
        <fieldset>
            <legend>已加载插件</legend>
            {% if all_plugins %}
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:0.35rem 0.75rem;max-height:240px;overflow:auto;padding:0.65rem;border:1px solid var(--pico-muted-border-color);border-radius:var(--radius-sm);">
                {% for p in all_plugins %}
                <label style="display:flex;align-items:center;gap:0.45rem;margin:0;min-width:0;">
                    <input type="checkbox" name="selected_plugins" value="{{ p }}"
                           {% if current_module and p in current_module.plugins %}checked{% endif %}>
                    <span style="overflow-wrap:anywhere;">{{ p }}</span>
                </label>
                {% endfor %}
            </div>
            {% else %}
            <input type="text" disabled value="暂无已加载插件">
            {% endif %}
        </fieldset>
        <label>
            其他插件名 (逗号或换行分隔)
            <textarea name="plugins" rows="3"
                      placeholder="nonebot_plugin_weather, nonebot_plugin_scheduler">{{ extra_plugins | default([]) | join(',') }}</textarea>
        </label>
        <div style="display:flex;gap:0.6rem;flex-wrap:wrap;">
            <button type="submit">保存</button>
            {% if current_module %}
            <a href="/ruok/modules" role="button" class="outline secondary">返回模块列表</a>
            {% endif %}
        </div>
        <div id="module-edit-result"></div>
    </form>
</details>
