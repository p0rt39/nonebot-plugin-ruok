<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark">
    <title>{% block title %}Nonebot, RUOK?{% endblock %} — NoneBot2 Health Monitor</title>
    <!-- Theme init: an explicit choice wins, otherwise follow the OS setting.
         Runs before first paint to avoid a flash of the wrong theme. -->
    <script>
        (function(){
            var stored = null;
            try { stored = localStorage.getItem('ruok-theme'); } catch (_) {}
            var dark = window.matchMedia
                && window.matchMedia('(prefers-color-scheme: dark)').matches;
            var t = stored || (dark ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', t);
            var meta = document.querySelector('meta[name="color-scheme"]');
            if (meta) meta.setAttribute('content', t === 'dark' ? 'dark light' : 'light dark');
        })();
    </script>
    <link rel="stylesheet" href="/ruok/static/vendor/pico/pico.min.css">
    <script src="/ruok/static/vendor/htmx/htmx.min.js"></script>
    <script src="/ruok/static/vendor/idiomorph/idiomorph-ext.min.js"></script>
    <script src="/ruok/static/vendor/chartjs/chart.umd.min.js"></script>
    <style>
        /* ── Design tokens ── */
        :root {
            --pico-font-size: 90%;
            --pico-line-height: 1.5;
            --pico-border-radius: 6px;
            --pico-spacing: 0.9rem;
            --pico-typography-spacing-vertical: 0.9rem;
            --pico-block-spacing-vertical: 0.9rem;
            --pico-block-spacing-horizontal: 1rem;
            --pico-form-element-spacing-vertical: 0.45rem;
            --pico-form-element-spacing-horizontal: 0.7rem;
            --pico-nav-element-spacing-vertical: 0.35rem;
            --pico-nav-element-spacing-horizontal: 0.6rem;

            --ruok-bg: #f3f5f7;
            --ruok-surface: #ffffff;
            --ruok-surface-2: #f7f8fa;
            --ruok-border: #dde1e6;
            --ruok-text: #373c44;
            --ruok-text-muted: #5f6b7a;
            --ruok-ok: #1a7f37;
            --ruok-ok-bg: #dcf5e3;
            --ruok-ok-fill: #2da44e;
            --ruok-warn: #8a5a00;
            --ruok-warn-bg: #fff4cc;
            --ruok-warn-fill: #d4a72c;
            --ruok-err: #c62828;
            --ruok-err-bg: #fde7e7;
            --ruok-err-fill: #e5534b;
            --ruok-muted: #57606a;
            --ruok-muted-bg: #eceff2;
            --ruok-muted-fill: #9aa4ae;
            --ruok-accent-bg: #e8f0fe;

            /* Legacy names still referenced by partials */
            --glass-bg: var(--ruok-surface);
            --glass-border: var(--ruok-border);
            --card-bg: var(--ruok-surface);
            --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.05);
            --shadow-md: 0 2px 8px rgba(15, 23, 42, 0.10);
            --shadow-lg: 0 4px 16px rgba(15, 23, 42, 0.12);
            --radius-sm: 6px;
            --radius-md: 6px;
            --radius-lg: 8px;
            --transition: 0.15s ease;
        }
        [data-theme="dark"] {
            --ruok-bg: #0f1318;
            --ruok-surface: #161b22;
            --ruok-surface-2: #1c222b;
            --ruok-border: #2d3440;
            --ruok-text: #c2c7d0;
            --ruok-text-muted: #9aa5b1;
            --ruok-ok: #56d364;
            --ruok-ok-bg: rgba(46, 160, 67, 0.18);
            --ruok-ok-fill: #3fb950;
            --ruok-warn: #e3b341;
            --ruok-warn-bg: rgba(187, 128, 9, 0.2);
            --ruok-warn-fill: #d29922;
            --ruok-err: #ff7b72;
            --ruok-err-bg: rgba(248, 81, 73, 0.18);
            --ruok-err-fill: #f85149;
            --ruok-muted: #9aa5b1;
            --ruok-muted-bg: rgba(110, 118, 129, 0.22);
            --ruok-muted-fill: #6e7681;
            --ruok-accent-bg: rgba(56, 139, 253, 0.15);
            --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.3);
            --shadow-md: 0 2px 8px rgba(0, 0, 0, 0.4);
            --shadow-lg: 0 4px 16px rgba(0, 0, 0, 0.45);
        }

        body {
            background: var(--ruok-bg);
            min-height: 100vh;
        }
        main.container {
            padding-top: 0.75rem;
        }
        h1, h2, h3, h4 {
            margin-bottom: 0.6rem;
        }
        h3 {
            font-size: 1.15rem;
            margin-top: 1.4rem;
        }
        h4 {
            font-size: 1rem;
        }

        /* ── Surfaces ── */
        article, .glass-card {
            background: var(--ruok-surface);
            border: 1px solid var(--ruok-border);
            border-radius: var(--radius-md);
            box-shadow: none;
            margin-bottom: 0.9rem;
            --pico-card-sectioning-background-color: var(--ruok-surface-2);
        }
        article > header, article > footer {
            border-color: var(--ruok-border);
        }

        /* ── Navigation ── */
        .ruok-nav {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            background: var(--ruok-surface);
            border: 1px solid var(--ruok-border);
            border-radius: var(--radius-md);
            padding: 0.2rem 0.75rem;
            position: sticky;
            top: 0.5rem;
            z-index: 100;
            margin-bottom: 1rem;
        }
        .ruok-nav ul {
            margin: 0;
            padding: 0;
            gap: 0.15rem;
            align-items: center;
        }
        .ruok-nav li {
            padding: 0.3rem 0;
        }
        .ruok-nav__brand strong {
            white-space: nowrap;
        }
        .ruok-nav__links {
            flex: 1;
            justify-content: center;
        }
        .ruok-nav__links a {
            display: inline-block;
            margin: 0;
            padding: 0.3rem 0.65rem;
            border-radius: var(--radius-sm);
            color: var(--pico-color);
            white-space: nowrap;
            text-decoration: none;
        }
        .ruok-nav__links a:hover {
            background: var(--ruok-surface-2);
        }
        .ruok-nav__links a[aria-current="page"] {
            background: var(--ruok-accent-bg);
            color: var(--pico-primary);
            font-weight: 600;
        }
        .ruok-nav__user {
            white-space: nowrap;
        }
        .ruok-nav__user small {
            color: var(--ruok-text-muted);
        }
        .ruok-nav__icon {
            display: inline-grid;
            place-items: center;
            min-width: 2rem;
            height: 2rem;
            margin: 0;
            padding: 0 0.4rem;
            border: 1px solid transparent;
            border-radius: var(--radius-sm);
            background: none;
            color: var(--pico-color);
            font-size: 0.95rem;
            line-height: 1;
            text-decoration: none;
            cursor: pointer;
        }
        .ruok-nav__icon:hover {
            border-color: var(--ruok-border);
            background: var(--ruok-surface-2);
        }
        @media (max-width: 768px) {
            .ruok-nav {
                flex-wrap: wrap;
                gap: 0;
                padding: 0.2rem 0.5rem;
            }
            .ruok-nav__brand {
                flex: 1;
            }
            .ruok-nav__links {
                order: 3;
                flex: 1 0 100%;
                justify-content: flex-start;
                flex-wrap: nowrap;
                overflow-x: auto;
                border-top: 1px solid var(--ruok-border);
                scrollbar-width: none;
            }
            .ruok-nav__links::-webkit-scrollbar {
                display: none;
            }
        }

        /* ── Overall status bar (dashboard hero / detail headers) ── */
        .hero-banner {
            display: grid;
            gap: 0.35rem;
            padding: 0.75rem 1rem;
            border-left: 4px solid var(--ruok-muted-fill);
            text-align: left;
        }
        .hero-banner.ok { border-left-color: var(--ruok-ok-fill); }
        .hero-banner.warn { border-left-color: var(--ruok-warn-fill); }
        .hero-banner.error { border-left-color: var(--ruok-err-fill); }
        .status-bar__main {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            flex-wrap: wrap;
        }
        .status-bar__title {
            font-size: 1.1rem;
        }
        .status-bar__ts,
        .status-bar__sub {
            color: var(--ruok-text-muted);
            font-size: 0.85em;
        }
        .status-bar__reasons {
            margin: 0;
            padding: 0;
            list-style: none;
            color: var(--ruok-text-muted);
            font-size: 0.85em;
        }
        .status-bar__reasons li {
            list-style: none;
            margin: 0;
        }
        .status-bar__desc {
            margin: 0;
            font-size: 0.9em;
        }

        /* ── Live-update connection indicator ── */
        .live-status {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            margin: 0 0 0.8rem;
            padding: 0.15rem 0.65rem 0.15rem 0.5rem;
            border: 1px solid var(--ruok-border);
            border-radius: 999px;
            background: var(--ruok-surface);
            color: var(--ruok-text-muted);
            font-size: 0.8em;
        }
        .live-status__dot {
            width: 8px;
            height: 8px;
            flex: none;
            border-radius: 50%;
            background: currentColor;
        }
        .live-status[data-state="open"] { color: var(--ruok-ok); }
        .live-status[data-state="paused"],
        .live-status[data-state="reconnecting"] { color: var(--ruok-warn); }
        .live-status[data-state="failed"] {
            color: var(--ruok-err);
            border-color: var(--ruok-err-fill);
        }

        /* ── Panel refresh state ── */
        .is-refreshing {
            opacity: 0.55;
            transition: opacity var(--transition);
        }
        .panel-note {
            display: flex;
            align-items: center;
            gap: 0.4rem;
            margin: 0 0 0.7rem;
            padding: 0.35rem 0.65rem;
            border-left: 3px solid var(--ruok-warn-fill);
            border-radius: var(--radius-sm);
            background: var(--ruok-warn-bg);
            color: var(--ruok-warn);
            font-size: 0.85em;
        }
        .panel-note--error {
            border-left-color: var(--ruok-err-fill);
            background: var(--ruok-err-bg);
            color: var(--ruok-err);
        }

        /* ── Animations (kept subtle) ── */
        @keyframes toastSlideIn {
            from { opacity: 0; transform: translateY(-6px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        @keyframes toastSlideOut {
            from { opacity: 1; }
            to   { opacity: 0; }
        }
        @keyframes shimmer {
            0%   { background-position: -200% 0; }
            100% { background-position: 200% 0; }
        }
        .animate-in, .pulse { animation: none; }

        /* ── Status dots ── */
        .status-dot {
            display: inline-block;
            width: 9px;
            height: 9px;
            border-radius: 50%;
            margin-right: 4px;
            vertical-align: middle;
            background: var(--ruok-muted-fill);
            flex: none;
        }
        .status-available, .status-solved { background: var(--ruok-ok-fill); }
        .status-degraded, .status-pending { background: var(--ruok-warn-fill); }
        .status-unavailable, .status-unsolved { background: var(--ruok-err-fill); }
        .status-ignored { background: var(--ruok-muted-fill); }

        /* ── Badges ── */
        .badge {
            display: inline-block;
            padding: 0.05rem 0.45rem;
            border-radius: 4px;
            font-size: 0.78em;
            font-weight: 600;
            line-height: 1.5;
            white-space: nowrap;
            color: var(--ruok-muted);
            background: var(--ruok-muted-bg);
        }
        .badge-ok    { color: var(--ruok-ok);   background: var(--ruok-ok-bg); }
        .badge-warn  { color: var(--ruok-warn); background: var(--ruok-warn-bg); }
        .badge-err,
        .badge-error { color: var(--ruok-err);  background: var(--ruok-err-bg); }
        .badge-muted { color: var(--ruok-muted); background: var(--ruok-muted-bg); }

        /* ── Tables ── */
        .table-scroll {
            max-width: 100%;
            overflow-x: auto;
            margin-bottom: 0.9rem;
            border: 1px solid var(--ruok-border);
            border-radius: var(--radius-md);
            background: var(--ruok-surface);
        }
        .table-scroll table {
            margin: 0;
        }
        @media (min-width: 601px) and (max-width: 768px) {
            /* Medium widths keep a bounded inner scroll instead of crushing
               columns. Below that the card layout takes over. */
            .table-scroll table {
                min-width: 40rem;
            }
        }

        /* ── Status tables: stacked cards on phones ── */
        @media (max-width: 600px) {
            .status-table-scroll {
                overflow-x: visible;
                border: none;
                background: none;
            }
            .status-table,
            .status-table tbody,
            .status-table tr,
            .status-table td {
                display: block;
                width: 100%;
            }
            .status-table thead {
                display: none;
            }
            .status-table tbody tr {
                margin-bottom: 0.6rem;
                padding: 0.5rem 0.6rem;
                border: 1px solid var(--ruok-border);
                border-radius: var(--radius-md);
                background: var(--ruok-surface);
            }
            .status-table tbody tr:last-child {
                margin-bottom: 0;
            }
            .status-table tbody tr:hover {
                background: var(--ruok-surface);
            }
            .status-table td {
                display: grid;
                grid-template-columns: minmax(4.5rem, 6.5rem) minmax(0, 1fr);
                gap: 0.6rem;
                align-items: baseline;
                padding: 0.3rem 0;
                border: none;
                min-width: 0;
                overflow-wrap: anywhere;
            }
            /* Badges and inline chips must hug their text, not fill the cell. */
            .status-table td > * {
                justify-self: start;
            }
            .status-table td::before {
                content: attr(data-label);
                color: var(--ruok-text-muted);
                font-size: 0.85em;
                font-weight: 600;
            }
            .status-table td[data-label]:empty {
                display: none;
            }
        }
        table {
            --pico-background-color: transparent;
            font-size: 0.92em;
        }
        th, td {
            padding: 0.45rem 0.7rem;
        }
        thead th {
            background: var(--ruok-surface-2);
            color: var(--ruok-text-muted);
            font-weight: 600;
            font-size: 0.85em;
            white-space: nowrap;
        }
        tbody tr:hover {
            background: var(--ruok-surface-2);
        }
        .cell-muted {
            color: var(--ruok-text-muted);
            font-size: 0.88em;
        }
        .cell-nowrap {
            white-space: nowrap;
        }
        .cell-name {
            min-width: 8rem;
            overflow-wrap: anywhere;
        }
        .cell-desc {
            min-width: 14rem;
            overflow-wrap: anywhere;
        }

        /* ── Buttons ── */
        button, [role="button"], input[type="submit"] {
            font-weight: 500;
        }
        .ruok-button-row {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
            align-items: center;
        }
        .ruok-button-row--end {
            justify-content: flex-end;
        }
        .ruok-button-row--grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
            gap: 0.5rem;
            align-items: stretch;
        }
        .ruok-button-row form {
            margin: 0;
        }
        .ruok-button,
        .ruok-button-row button,
        .ruok-button-row [role="button"],
        .ruok-button-row--grid button,
        .ruok-button-row--grid [role="button"] {
            min-height: 2.3rem;
            margin-bottom: 0;
            text-align: center;
        }
        .ruok-button-row--grid button,
        .ruok-button-row--grid [role="button"] {
            width: 100%;
        }
        .ruok-button-danger {
            --pico-color: var(--ruok-err);
            color: var(--ruok-err) !important;
            border-color: var(--ruok-err) !important;
        }
        .ruok-button-danger:hover {
            background: var(--ruok-err-bg) !important;
        }
        .ruok-icon-button {
            width: 1.75rem;
            height: 1.75rem;
            min-height: 1.75rem;
            padding: 0;
            margin: 0;
            line-height: 1;
            display: inline-grid;
            place-items: center;
        }
        .ruok-button-compact {
            min-height: 1.9rem !important;
            padding: 0.2rem 0.6rem;
            font-size: 0.85em;
        }
        .ruok-button-full {
            width: 100%;
        }
        .ruok-form-actions {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
            gap: 0.5rem;
            align-items: stretch;
            max-width: 22rem;
        }
        .ruok-form-actions button,
        .ruok-form-actions [role="button"] {
            width: 100%;
            min-height: 2.3rem;
            margin-bottom: 0;
            text-align: center;
        }
        .confirm-plugin-picker {
            position: relative;
            margin: 0;
        }
        .confirm-plugin-picker summary {
            display: flex;
            align-items: center;
            justify-content: center;
            list-style: none;
            cursor: pointer;
        }
        .confirm-plugin-picker summary::-webkit-details-marker {
            display: none;
        }
        .confirm-plugin-picker summary::after {
            display: none;
        }
        .confirm-plugin-options {
            display: grid;
            gap: 0.4rem;
            margin-top: 0.4rem;
            padding: 0.6rem;
            border: 1px solid var(--ruok-border);
            border-radius: var(--radius-sm);
            background: var(--ruok-surface);
            box-shadow: var(--shadow-md);
        }
        .confirm-plugin-options label {
            margin: 0;
            overflow-wrap: anywhere;
        }

        /* ── Form inputs ── */
        input:not([type="checkbox"], [type="radio"]), select, textarea {
            --pico-box-shadow: none;
        }
        input[type="checkbox"] {
            border-radius: 4px;
        }
        fieldset legend {
            font-weight: 500;
        }
        .choice-group {
            display: flex;
            flex-wrap: wrap;
            gap: 0.4rem 1rem;
            margin: 0.25rem 0 0.9rem;
        }
        .choice-group label {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            margin: 0;
        }
        .choice-group--grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            max-height: 240px;
            overflow: auto;
            padding: 0.6rem;
            border: 1px solid var(--ruok-border);
            border-radius: var(--radius-sm);
        }
        .choice-group--grid span {
            overflow-wrap: anywhere;
        }
        .form-panel > summary {
            font-weight: 600;
        }
        .form-panel[open] > summary {
            margin-bottom: 0.75rem;
        }
        .ruok-picker-controls {
            display: flex;
            align-items: flex-start;
            gap: 0.5rem;
            flex-wrap: wrap;
        }
        .ruok-picker-controls input {
            flex: 1 1 260px;
            min-width: 0;
            margin-bottom: 0;
        }
        .ruok-picker-controls button {
            flex: 0 0 auto;
            width: 2.6rem;
            margin-bottom: 0;
        }
        .ruok-picker-list {
            display: flex;
            flex-wrap: wrap;
            gap: 0.4rem;
            min-height: 2.4rem;
            margin-top: 0.5rem;
            padding: 0.5rem;
            border: 1px solid var(--ruok-border);
            border-radius: var(--radius-sm);
        }
        .ruok-picker-chip {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            max-width: 100%;
            padding: 0.15rem 0.5rem;
            border: 1px solid var(--ruok-border);
            border-radius: var(--radius-sm);
            background: var(--ruok-accent-bg);
        }
        .ruok-picker-chip span {
            overflow-wrap: anywhere;
        }
        .ruok-picker-remove {
            width: 1.35rem;
            height: 1.35rem;
            padding: 0;
            margin: 0;
            line-height: 1;
        }

        /* ── User management ── */
        .user-admin-layout {
            display: grid;
            gap: 0.9rem;
        }
        .user-toolbar {
            display: grid;
            grid-template-columns: minmax(260px, 0.75fr) minmax(280px, 1.25fr);
            gap: 0.9rem;
            align-items: stretch;
        }
        .user-toolbar article {
            margin: 0;
            height: 100%;
        }
        .user-search-form {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            gap: 0.5rem;
            align-items: end;
        }
        .user-search-form label,
        .user-search-form input,
        .user-search-form button {
            margin-bottom: 0;
        }
        .user-card-list {
            display: grid;
            gap: 0.6rem;
        }
        .user-card-list > article {
            margin: 0;
        }
        .user-card {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(260px, 0.9fr);
            gap: 0.9rem;
            align-items: start;
        }
        .user-card--readonly {
            grid-template-columns: 1fr;
        }
        .user-card__main {
            display: grid;
            gap: 0.6rem;
            min-width: 0;
        }
        .user-card__header,
        .account-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 0.75rem;
            flex-wrap: wrap;
        }
        .user-meta {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
            gap: 0.5rem;
            margin: 0;
        }
        .user-meta div {
            min-width: 0;
        }
        .user-meta dd {
            margin: 0;
            overflow-wrap: anywhere;
        }
        .user-meta dt {
            color: var(--ruok-text-muted);
            font-size: 0.8em;
        }
        .user-card__actions {
            display: grid;
            gap: 0.5rem;
            align-content: start;
        }
        .user-edit-form {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
            gap: 0.5rem;
            align-items: end;
        }
        .user-edit-form label,
        .user-edit-form input,
        .user-edit-form button {
            margin-bottom: 0;
        }
        .user-button-row {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 0.5rem;
        }
        .user-button-row button {
            width: 100%;
            min-height: 2.3rem;
            margin-bottom: 0;
        }
        .user-card__actions form,
        .account-actions form {
            margin: 0;
        }
        .auth-key-result {
            padding: 0.7rem 0.9rem;
            border-radius: var(--radius-sm);
            border: 1px solid var(--ruok-ok-fill);
            background: var(--ruok-ok-bg);
            margin-bottom: 0.9rem;
        }
        .auth-key-result code {
            overflow-wrap: anywhere;
            white-space: normal;
        }
        .account-actions {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 0.9rem;
        }

        /* ── Layout ── */
        .card-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 0.9rem;
            margin-bottom: 1.2rem;
        }
        .card-grid > article {
            margin: 0;
        }
        .metric-value { font-size: 1.6rem; font-weight: 700; }
        .metric-label { font-size: 0.82em; color: var(--ruok-text-muted); }
        .auto-refresh { opacity: 0.5; font-size: 0.75em; }
        .muted-text { color: var(--ruok-text-muted); }

        .info-chip {
            background: var(--ruok-surface);
            border: 1px solid var(--ruok-border);
            border-radius: var(--radius-sm);
            padding: 0.4rem 0.8rem;
            white-space: nowrap;
        }

        /* ── System overview tiles ── */
        .sys-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
            gap: 0.75rem;
            align-items: start;
            margin-bottom: 1.2rem;
        }
        @media (max-width: 768px) {
            .sys-grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
        }
        .sys-tile {
            margin: 0;
            padding: 0.8rem !important;
            position: relative;
            overflow: hidden;
            cursor: default;
            transition: border-color var(--transition);
        }
        .sys-tile[data-expandable] {
            cursor: pointer;
        }
        .sys-tile[data-expandable]:hover {
            border-color: var(--pico-primary);
        }
        .sys-tile[data-expandable]:focus-visible {
            outline: 2px solid var(--pico-primary);
            outline-offset: 2px;
        }
        /* Tiles carry role="button" for keyboard access. Pico styles that
           selector as a filled button, so restore the card surface and text. */
        .sys-tile[role="button"] {
            --pico-background-color: var(--ruok-surface);
            --pico-color: var(--ruok-text);
            display: block;
            width: auto;
            margin: 0;
            background: var(--ruok-surface);
            color: var(--ruok-text);
            border: 1px solid var(--ruok-border);
            border-radius: var(--radius-md);
            box-shadow: none;
            text-align: inherit;
            font-weight: inherit;
            padding: 0.8rem !important;
        }
        .sys-tile[role="button"]:hover,
        .sys-tile[role="button"]:focus {
            --pico-background-color: var(--ruok-surface);
            --pico-color: var(--ruok-text);
            background: var(--ruok-surface);
            color: var(--ruok-text);
        }
        .sys-tile[role="button"] * {
            --pico-color: var(--ruok-text);
        }
        .sys-tile[role="button"] .sys-tile__label,
        .sys-tile[role="button"] .sys-tile__sub {
            --pico-color: var(--ruok-text-muted);
        }
        .sys-tile--gauge {
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .sys-gauge {
            width: 96px;
            height: 96px;
        }
        .sys-gauge__track {
            stroke: var(--ruok-border);
        }
        .sys-tile--stat {
            text-align: center;
        }
        .sys-tile__icon {
            font-size: 1.1rem;
            margin-bottom: 0.15rem;
        }
        .sys-tile__value {
            font-size: 1.4rem;
            font-weight: 700;
            line-height: 1.2;
        }
        .sys-tile__label {
            font-size: 0.78em;
            color: var(--ruok-text-muted);
            margin-top: 0.15rem;
        }
        .sys-tile__sub {
            font-size: 0.75em;
            color: var(--ruok-text-muted);
            margin-top: 0.2rem;
        }
        .sys-metric-rows {
            font-size: 1rem;
            font-weight: 600;
            line-height: 1.5;
        }
        .sys-metric-rows span {
            font-family: 'JetBrains Mono', 'Cascadia Code', 'Consolas', monospace;
        }
        .sys-tile__face {
            position: relative;
            z-index: 1;
        }
        .sys-tile__expand {
            max-height: 0;
            opacity: 0;
            overflow: hidden;
            transition: max-height 0.3s ease, opacity 0.2s ease, margin-top 0.2s ease;
            margin-top: 0;
        }
        .sys-tile.expanded .sys-tile__expand {
            max-height: 600px;
            opacity: 1;
            margin-top: 0.6rem;
        }
        .sys-expand-content {
            border-top: 1px solid var(--ruok-border);
            padding-top: 0.6rem;
            font-size: 0.82em;
            text-align: left;
            line-height: 1.6;
        }
        .sys-expand-content > div {
            padding: 2px 0;
        }
        .sys-progress-bar {
            height: 6px;
            background: var(--ruok-muted-bg);
            border-radius: 3px;
            margin-top: 4px;
            overflow: hidden;
        }
        .sys-progress-fill {
            height: 100%;
            border-radius: 3px;
            transition: width 0.6s ease;
            min-width: 2px;
        }
        .sys-core-heatmap {
            display: grid;
            grid-template-columns: repeat(8, 12px);
            gap: 3px;
            justify-content: start;
            margin-top: 0.4rem;
        }
        .sys-core-heatmap span {
            display: block;
            width: 12px;
            height: 12px;
            border-radius: 2px;
            transition: background 0.3s ease, opacity 0.3s ease;
        }
        .sys-sparkline {
            width: 100%;
            height: 32px;
            margin-top: 0.3rem;
            overflow: visible;
            color: var(--ruok-text-muted);
        }
        .sys-sparkline polyline {
            vector-effect: non-scaling-stroke;
        }

        /* ── Disk partition list ── */
        .disk-list {
            background: var(--ruok-surface);
            border: 1px solid var(--ruok-border);
            border-radius: var(--radius-md);
            overflow: hidden;
            margin-bottom: 1.2rem;
        }
        .disk-row {
            display: flex;
            align-items: center;
            gap: 0.65rem;
            padding: 0.45rem 0.9rem;
            font-size: 0.9em;
            border-bottom: 1px solid var(--ruok-border);
        }
        .disk-row:last-child { border-bottom: none; }
        .disk-row:hover { background: var(--ruok-surface-2); }
        .disk-mount {
            font-weight: 600;
            min-width: 3em;
            white-space: nowrap;
        }
        .disk-fstype {
            font-size: 0.72em;
            padding: 1px 6px;
            border-radius: 4px;
            background: var(--ruok-muted-bg);
            color: var(--ruok-text-muted);
            white-space: nowrap;
        }
        .disk-bar-wrap {
            flex: 1;
            height: 6px;
            border-radius: 3px;
            background: var(--ruok-muted-bg);
            overflow: hidden;
            min-width: 60px;
        }
        .disk-bar {
            display: block;
            height: 100%;
            border-radius: 3px;
            transition: width 0.4s ease;
            min-width: 2px;
        }
        .disk-pct {
            font-weight: 600;
            font-size: 0.9em;
            min-width: 3.5em;
            text-align: right;
            white-space: nowrap;
        }
        .disk-free {
            font-size: 0.8em;
            color: var(--ruok-text-muted);
            min-width: 6em;
            text-align: right;
            white-space: nowrap;
        }
        @media (max-width: 480px) {
            .disk-fstype, .disk-free { display: none; }
        }

        .gauge-card {
            background: var(--ruok-surface);
            border: 1px solid var(--ruok-border);
            border-radius: var(--radius-md);
        }

        /* ── Occurrence list ── */
        .occurrence-list { max-height: 300px; overflow-y: auto; font-size: 0.85em; }
        .occurrence-list pre {
            margin: 4px 0; padding: 8px;
            background: var(--ruok-surface-2); border-radius: var(--radius-sm);
            font-size: 0.82em;
        }

        /* ── Loading skeleton ── */
        .skeleton {
            background: linear-gradient(90deg, var(--ruok-muted-bg) 25%, var(--ruok-surface-2) 50%, var(--ruok-muted-bg) 75%);
            background-size: 200% 100%;
            animation: shimmer 1.5s infinite;
            border-radius: var(--radius-sm);
        }

        /* ── Session list ── */
        .session-list {
            margin-bottom: 0.9rem;
            border: 1px solid var(--ruok-border);
            border-radius: var(--radius-md);
            background: var(--ruok-surface);
        }
        .session-row {
            display: grid;
            grid-template-columns: 4.6rem 7.6rem minmax(5rem, 9rem) minmax(0, 1fr) 6.2rem 12.5rem;
            gap: 0.4rem 0.75rem;
            align-items: center;
            padding: 0.45rem 0.75rem;
            border-bottom: 1px solid var(--ruok-border);
            font-size: 0.92em;
        }
        .session-row:last-child {
            border-bottom: none;
        }
        .session-row:not(.session-row--head):hover {
            background: var(--ruok-surface-2);
        }
        .session-row--head {
            background: var(--ruok-surface-2);
            color: var(--ruok-text-muted);
            font-size: 0.8em;
            font-weight: 600;
            border-radius: var(--radius-md) var(--radius-md) 0 0;
        }
        .session-row__id a {
            font-family: 'JetBrains Mono', 'Cascadia Code', 'Consolas', monospace;
            font-size: 0.92em;
            white-space: nowrap;
        }
        .session-row__module,
        .session-row__summary {
            min-width: 0;
        }
        .session-row__module {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .session-row__text {
            display: block;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .session-row__meta {
            display: block;
            color: var(--ruok-text-muted);
            font-size: 0.85em;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .session-row__time {
            color: var(--ruok-text-muted);
            font-size: 0.85em;
            line-height: 1.3;
        }
        .session-row__actions .ruok-button-row--grid {
            display: flex;
            gap: 0.3rem;
            justify-content: flex-end;
            flex-wrap: nowrap;
        }
        .session-row__actions form {
            margin: 0;
        }
        .session-row__actions button,
        .session-row__actions .confirm-plugin-picker > summary {
            width: auto;
            min-height: 0;
            margin: 0;
            padding: 0.2rem 0.55rem;
            font-size: 0.82em;
            white-space: nowrap;
        }
        .session-row__actions .confirm-plugin-options {
            position: absolute;
            right: 0;
            z-index: 30;
            min-width: 15rem;
        }
        .session-list__empty {
            padding: 1rem;
            color: var(--ruok-text-muted);
        }
        @media (max-width: 900px) {
            .session-row--head {
                display: none;
            }
            .session-row {
                grid-template-columns: auto minmax(0, 1fr) auto;
                grid-template-areas:
                    "status id time"
                    "module module module"
                    "summary summary summary"
                    "actions actions actions";
                padding: 0.6rem 0.75rem;
            }
            .session-row__status { grid-area: status; }
            .session-row__id { grid-area: id; }
            .session-row__time { grid-area: time; text-align: right; }
            .session-row__module { grid-area: module; font-size: 0.9em; }
            .session-row__summary { grid-area: summary; }
            .session-row__actions { grid-area: actions; }
            .session-row__actions:empty { display: none; }
            .session-row__actions .ruok-button-row--grid {
                justify-content: flex-start;
                flex-wrap: wrap;
            }
            .session-row__actions .confirm-plugin-options {
                left: 0;
                right: auto;
            }
        }

        /* ── HTMX indicators ── */
        .htmx-indicator { opacity: 0; transition: opacity 0.2s ease; }
        .htmx-request .htmx-indicator { opacity: 1; }
        .htmx-request.htmx-indicator { opacity: 1; }
        .htmx-busy {
            opacity: 0.72;
            pointer-events: none;
        }

        /* ── Form feedback ── */
        .ruok-form-status {
            display: none;
            align-items: center;
            gap: 0.4rem;
            margin: 0.5rem 0 0;
            padding: 0.45rem 0.7rem;
            border-radius: var(--radius-sm);
            font-size: 0.88em;
        }
        .ruok-form-status[data-state] {
            display: flex;
        }
        .ruok-form-status[data-state="busy"] {
            border-left: 3px solid var(--ruok-muted-fill);
            background: var(--ruok-muted-bg);
            color: var(--ruok-muted);
        }
        .ruok-form-status[data-state="error"] {
            border-left: 3px solid var(--ruok-err-fill);
            background: var(--ruok-err-bg);
            color: var(--ruok-err);
        }
        .ruok-form-status[data-state="success"] {
            border-left: 3px solid var(--ruok-ok-fill);
            background: var(--ruok-ok-bg);
            color: var(--ruok-ok);
        }
        /* ── Focus visibility ── */
        :where(a, button, input, select, textarea, summary, [role="button"]):focus-visible {
            outline: 2px solid var(--pico-primary);
            outline-offset: 2px;
        }

        /* Text for screen readers only; state dots are decorative. */
        .visually-hidden {
            position: absolute;
            width: 1px;
            height: 1px;
            margin: -1px;
            padding: 0;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }

        /* ── Footer ── */
        footer.ruok-footer {
            margin-top: 2rem;
            padding: 1rem 0;
            border-top: 1px solid var(--ruok-border);
            text-align: center;
            font-size: 0.82em;
            color: var(--ruok-text-muted);
        }

        /* ── Mobile ── */
        @media (max-width: 768px) {
            .card-grid { grid-template-columns: 1fr; }
            .gauge-card { min-width: 100px !important; }
            .gauge-card svg { width: 90px !important; height: 90px !important; }
            .user-toolbar,
            .user-card,
            .user-edit-form,
            .user-search-form,
            .user-button-row {
                grid-template-columns: 1fr;
            }
        }

        /* ── Toast notifications ── */
        #toast-container {
            position: fixed; top: 0.75rem; right: 0.75rem; z-index: 9999;
            display: flex; flex-direction: column; gap: 0.5rem;
            max-width: min(360px, calc(100vw - 1.5rem));
        }
        .toast {
            padding: 0.6rem 0.9rem;
            border-radius: var(--radius-sm);
            border: 1px solid var(--ruok-border);
            border-left-width: 4px;
            background: var(--ruok-surface);
            color: var(--pico-color);
            font-weight: 500;
            box-shadow: var(--shadow-md);
            animation: toastSlideIn 0.18s ease-out;
        }
        .toast-success { border-left-color: var(--ruok-ok-fill); }
        .toast-warning { border-left-color: var(--ruok-warn-fill); }
        .toast-error   { border-left-color: var(--ruok-err-fill); }
        .toast-info    { border-left-color: var(--pico-primary); }
        .toast-removing { animation: toastSlideOut 0.2s ease-in forwards; }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                transition-duration: 0.01ms !important;
                animation-duration: 0.01ms !important;
            }
        }
    </style>
    {% block head %}{% endblock %}
</head>
<body>
    <!-- Toast container -->
    <div id="toast-container" aria-live="polite"></div>
    <main class="container">
        <nav class="ruok-nav" aria-label="主导航">
            <ul class="ruok-nav__brand">
                <li><strong>Nonebot, RUOK?</strong></li>
            </ul>
            <ul class="ruok-nav__links" id="nav-links">
                <li><a href="/ruok" {% if active_page == 'dashboard' %}aria-current="page"{% endif %}>总览</a></li>
                {% if current_user and current_user.is_admin %}
                <li><a href="/ruok/sessions" {% if active_page == 'sessions' %}aria-current="page"{% endif %}>Sessions</a></li>
                <li><a href="/ruok/modules" {% if active_page == 'modules' %}aria-current="page"{% endif %}>模块</a></li>
                <li><a href="/ruok/notifications" {% if active_page == 'notifications' %}aria-current="page"{% endif %}>通知</a></li>
                {% endif %}
                {% if current_user %}
                <li><a href="/ruok/users" {% if active_page == 'users' %}aria-current="page"{% endif %}>账号</a></li>
                {% endif %}
            </ul>
            <ul class="ruok-nav__user">
                {% if current_user %}
                <li>
                    <small>
                        {{ current_user.username }}
                        {% if current_user.admin_source == 'superuser' %} · SUPERUSER{% endif %}
                    </small>
                </li>
                {% endif %}
                <li>
                    <button id="theme-toggle" type="button" class="ruok-nav__icon"
                            aria-label="切换暗色模式" title="切换暗色模式">🌙</button>
                </li>
                <li><a href="/ruok/logout" class="ruok-nav__icon" title="退出登录">退出</a></li>
            </ul>
        </nav>

        {% block content %}{% endblock %}
    </main>

    <footer class="ruok-footer container">
        Nonebot, RUOK? · NoneBot2 Health Monitor
    </footer>

<script>
// ── Theme toggle ──
(function() {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    function syncButton(t) {
        btn.textContent = t === 'dark' ? '☀️' : '🌙';
        btn.setAttribute('aria-label', t === 'dark' ? '切换亮色模式' : '切换暗色模式');
        btn.setAttribute('aria-pressed', t === 'dark' ? 'true' : 'false');
        btn.setAttribute('title', t === 'dark' ? '切换亮色模式' : '切换暗色模式');
    }
    function applyTheme(t, persist) {
        document.documentElement.setAttribute('data-theme', t);
        var meta = document.querySelector('meta[name="color-scheme"]');
        if (meta) {
            meta.setAttribute('content', t === 'dark' ? 'dark light' : 'light dark');
        }
        if (persist) {
            try { localStorage.setItem('ruok-theme', t); } catch (_) {}
        }
        syncButton(t);
    }
    function current() {
        return document.documentElement.getAttribute('data-theme') || 'light';
    }
    btn.addEventListener('click', function() {
        applyTheme(current() === 'dark' ? 'light' : 'dark', true);
    });
    applyTheme(current(), false);
    // Without an explicit choice, keep following the OS setting.
    if (window.matchMedia) {
        var query = window.matchMedia('(prefers-color-scheme: dark)');
        var onChange = function() {
            var stored = null;
            try { stored = localStorage.getItem('ruok-theme'); } catch (_) {}
            if (!stored) applyTheme(query.matches ? 'dark' : 'light', false);
        };
        if (query.addEventListener) query.addEventListener('change', onChange);
        else if (query.addListener) query.addListener(onChange);
    }
})();
</script>

<script>
// ── Searchable form pickers ──
(function() {
    function addPickerValue(picker) {
        var input = picker.querySelector('[data-picker-input]');
        var list = picker.querySelector('[data-picker-list]');
        if (!input || !list) return;
        var value = input.value.trim();
        if (!value) return;
        var existing = list.querySelectorAll('[data-picker-value]');
        for (var i = 0; i < existing.length; i++) {
            if (existing[i].getAttribute('data-picker-value') === value) {
                input.value = '';
                return;
            }
        }
        var fieldName = picker.getAttribute('data-field-name');
        if (!fieldName) return;

        var chip = document.createElement('span');
        chip.className = 'ruok-picker-chip';
        chip.setAttribute('data-picker-value', value);

        var label = document.createElement('span');
        label.textContent = value;

        var hidden = document.createElement('input');
        hidden.type = 'hidden';
        hidden.name = fieldName;
        hidden.value = value;

        var remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'outline secondary ruok-picker-remove';
        remove.title = '移除 ' + value;
        remove.setAttribute('aria-label', '移除 ' + value);
        remove.setAttribute('data-picker-remove', '');
        remove.innerHTML = '&times;';

        chip.appendChild(label);
        chip.appendChild(hidden);
        chip.appendChild(remove);
        list.appendChild(chip);
        input.value = '';
    }

    document.body.addEventListener('click', function(e) {
        var add = e.target.closest('[data-picker-add]');
        if (add) {
            var picker = add.closest('.ruok-picker');
            if (picker) addPickerValue(picker);
            return;
        }
        var remove = e.target.closest('[data-picker-remove]');
        if (remove) {
            var chip = remove.closest('[data-picker-value]');
            if (chip) chip.remove();
        }
    });

    document.body.addEventListener('keydown', function(e) {
        if (e.key !== 'Enter') return;
        var input = e.target.closest('[data-picker-input]');
        if (!input) return;
        var picker = input.closest('.ruok-picker');
        if (!picker) return;
        e.preventDefault();
        addPickerValue(picker);
    });

    // Notification form: show the Webhook URL only when the channel is selected.
    document.body.addEventListener('change', function(e) {
        var toggle = e.target.closest('[data-webhook-toggle]');
        if (!toggle) return;
        var form = toggle.closest('form');
        var field = form && form.querySelector('[data-webhook-field]');
        if (field) field.hidden = !toggle.checked;
    });
})();
</script>

<script>
// ── Toast notification system ──
(function() {
    var container = document.getElementById('toast-container');
    if (!container) return;

    function showToast(msg, type) {
        type = type || 'info';
        var el = document.createElement('div');
        el.className = 'toast toast-' + type;
        el.textContent = msg;
        container.appendChild(el);
        setTimeout(function() {
            el.classList.add('toast-removing');
            setTimeout(function() { el.remove(); }, 300);
        }, 3500);
    }

    // Listen for HTMX HX-Trigger response headers
    document.body.addEventListener('htmx:afterOnLoad', function(e) {
        try {
            var trigger = e.detail.xhr.getResponseHeader('HX-Trigger');
            if (!trigger) return;
            var data = JSON.parse(trigger);
            if (data.toast) {
                showToast(data.toast, data.toastType || 'success');
            }
            // If action requests a re-render of a target element
            if (data.refresh) {
                var target = document.querySelector(data.refresh);
                if (target) {
                    htmx.ajax('GET', data.refreshUrl || window.location.pathname + '?' + (data.refreshParam || ''),
                        { target: data.refresh, swap: 'innerHTML' });
                }
            }
        } catch(_) {}
    });

    // htmx does not swap 4xx/5xx bodies; surface the server's message instead.
    // Forms that render the failure inline skip the toast to avoid saying the
    // same thing twice.
    document.body.addEventListener('htmx:responseError', function(e) {
        var elt = e.detail.elt;
        var form = elt && (elt.tagName === 'FORM'
            ? elt : (elt.closest ? elt.closest('form') : null));
        if (form && form.querySelector('[data-form-status]')) return;
        showToast(window.ruokErrorMessage(e.detail.xhr), 'error');
    });
    document.body.addEventListener('htmx:sendError', function() {
        showToast('无法连接服务器，请稍后重试', 'error');
    });
})();
</script>
<script>
// ── HTMX form feedback ──
(function() {
    var regionSeq = 0;

    function submitterFromEvent(event) {
        var elt = event.detail && event.detail.elt;
        if (!elt) return null;
        if (elt.matches('button, [role="button"], input[type="submit"]')) return elt;
        if (elt.tagName === 'FORM') {
            return elt.querySelector('button[type="submit"], input[type="submit"]');
        }
        return elt.closest('button, [role="button"], input[type="submit"]');
    }

    // The region lives inside the form so it survives a target swap that
    // replaces the surrounding list or container. Compact Session list rows
    // keep their tight grid and rely on the error toast instead.
    function regionFor(elt) {
        if (!elt) return null;
        var form = elt.tagName === 'FORM' ? elt : elt.closest('form');
        if (!form || form.closest('.session-row')) return null;
        var region = form.querySelector('[data-form-status]');
        if (region) return region;
        region = document.createElement('p');
        region.className = 'ruok-form-status';
        region.id = 'ruok-form-status-' + (++regionSeq);
        region.setAttribute('data-form-status', '');
        region.setAttribute('role', 'status');
        region.setAttribute('aria-live', 'polite');
        form.appendChild(region);
        return region;
    }

    function setState(region, state, message) {
        if (!region) return;
        if (!state) {
            region.removeAttribute('data-state');
            region.textContent = '';
            return;
        }
        region.setAttribute('data-state', state);
        region.textContent = message;
    }

    var FIELD_LABELS = {
        name: '名称', original_name: '原名称', display_name: '显示名',
        description: '描述', module_name: '模块名', user_id: '上报用户',
        status: '状态', affected_plugins: '影响插件', username: '用户名',
        password: '密码', current_password: '当前密码',
        new_password: '新密码', new_password_confirm: '确认新密码',
        confirm_username: '确认用户名', cooldown_minutes: '冷却时间',
        on_status: '触发状态', channels: '通知通道', webhook_url: 'Webhook URL',
        developer_notes: '开发者备注', other_id: 'Session ID',
    };

    function fieldLabel(field) {
        if (!field) return '字段';
        return FIELD_LABELS[field] || field;
    }

    // FastAPI's own form validation answers 422 with a JSON `detail` list.
    // Rendering that raw would show the user a Python-shaped payload.
    function describeValidationError(details) {
        var missing = [];
        var other = [];
        details.forEach(function(item) {
            if (!item || typeof item !== 'object') return;
            var field = (item.loc || []).filter(function(part) {
                return part !== 'body' && part !== 'query' && part !== 'path';
            }).pop();
            if (item.type === 'missing') missing.push(fieldLabel(field));
            else other.push(fieldLabel(field));
        });
        if (missing.length) return '请填写：' + missing.join('、');
        if (other.length) return '请检查：' + other.join('、');
        return '提交的内容不合法，请检查后重试';
    }

    function messageFromXhr(xhr) {
        var body = xhr.responseText || '';
        try {
            var data = JSON.parse(body);
            if (data && typeof data.detail === 'string') return data.detail;
            if (data && Array.isArray(data.detail)) {
                return describeValidationError(data.detail);
            }
            if (data && data.detail) return '请求失败 (' + xhr.status + ')';
        } catch(_) {}
        var text = '';
        try {
            var doc = new DOMParser().parseFromString(body, 'text/html');
            text = (doc.body.textContent || '').replace(/\s+/g, ' ').trim();
        } catch(_) {}
        if (text.length > 200) text = text.slice(0, 199) + '…';
        return text || ('请求失败 (' + xhr.status + ')');
    }

    // Shared with the toast handler and the HTMX-error listener below.
    window.ruokErrorMessage = messageFromXhr;

    document.body.addEventListener('htmx:beforeRequest', function(event) {
        var elt = event.detail && event.detail.elt;
        var button = submitterFromEvent(event);
        if (button) {
            button.classList.add('htmx-busy');
            button.setAttribute('aria-busy', 'true');
            button.dataset.ruokBusy = 'true';
        }
        var region = regionFor(elt);
        if (region) setState(region, 'busy', '正在提交…');
    });

    document.body.addEventListener('htmx:afterRequest', function(event) {
        document.querySelectorAll('[data-ruok-busy="true"]').forEach(function(button) {
            button.classList.remove('htmx-busy');
            button.removeAttribute('aria-busy');
            delete button.dataset.ruokBusy;
        });
        var elt = event.detail && event.detail.elt;
        var region = regionFor(elt);
        if (!region) return;
        var xhr = event.detail.xhr;
        if (event.detail.successful) {
            // Success is usually followed by a swap or redirect; keep a short
            // confirmation for the swaps that leave the form in place.
            setState(region, 'success', '已保存');
            return;
        }
        setState(region, 'error', messageFromXhr(xhr));
    });
})();
</script>
</body>
</html>
