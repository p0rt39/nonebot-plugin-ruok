<!-- CPU + Memory trend charts with a selectable time range -->
{% set trend_ranges = [
    {"hours": 1, "label": "1 小时"},
    {"hours": 6, "label": "6 小时"},
    {"hours": 24, "label": "24 小时"},
    {"hours": 72, "label": "3 天"},
    {"hours": 168, "label": "7 天"},
] %}
<div class="trend-toolbar">
    <div class="trend-range" role="group" aria-label="时间尺度" data-trend-range>
        {% for option in trend_ranges %}
        <button type="button" class="trend-range__btn"
                data-trend-hours="{{ option.hours }}"
                aria-pressed="{{ 'true' if option.hours == 1 else 'false' }}">
            {{ option.label }}
        </button>
        {% endfor %}
    </div>
    <p class="trend-status" data-trend-status role="status" aria-live="polite">
        显示最近 1 小时（每 10 秒一个采样点）
    </p>
</div>
<p class="panel-note panel-note--error" data-trend-error role="alert" hidden></p>
<div class="grid">
    <article>
        <h4 style="margin-bottom:0.5rem;">CPU</h4>
        <div style="position:relative; height:260px; min-height:220px; width:100%;">
            <canvas id="chart-cpu" aria-label="CPU 使用率趋势" role="img"
                    style="display:block; width:100%; height:100%;"></canvas>
        </div>
    </article>
    <article>
        <h4 style="margin-bottom:0.5rem;">Memory</h4>
        <div style="position:relative; height:260px; min-height:220px; width:100%;">
            <canvas id="chart-memory" aria-label="内存使用率趋势" role="img"
                    style="display:block; width:100%; height:100%;"></canvas>
        </div>
    </article>
</div>
<script>
(function() {
    var DATA_URL = '/ruok/_partials/dashboard-trends-data';
    var DEFAULT_HOURS = 1;
    // Live SSE samples append to the loaded window; they must not evict the
    // history the user asked for, so keep a separate cap for them.
    var MAX_LIVE_POINTS = 120;
    var initialHours = {{ metrics_history_hours | default(1) | int }};
    var initialMetrics = {{ metrics_history | default([]) | tojson }};
    var cpuCanvas = document.getElementById('chart-cpu');
    var memCanvas = document.getElementById('chart-memory');

    if (!cpuCanvas && !memCanvas) return;
    if (typeof Chart === 'undefined') return;

    if (window.ruokTrendRefreshTimer) {
        window.clearInterval(window.ruokTrendRefreshTimer);
    }
    if (window.ruokTrendMetricsListener) {
        document.removeEventListener('ruok:metrics', window.ruokTrendMetricsListener);
    }
    if (window.ruokTrendResizeListener) {
        window.removeEventListener('resize', window.ruokTrendResizeListener);
    }
    if (window.ruokTrendRangeListener) {
        document.removeEventListener('click', window.ruokTrendRangeListener);
    }
    if (window.ruokTrendCharts) {
        if (window.ruokTrendCharts.cpu &&
                window.ruokTrendCharts.cpu.canvas !== cpuCanvas) {
            window.ruokTrendCharts.cpu.destroy();
        }
        if (window.ruokTrendCharts.mem &&
                window.ruokTrendCharts.mem.canvas !== memCanvas) {
            window.ruokTrendCharts.mem.destroy();
        }
    }

    var hours = Number(initialHours) || DEFAULT_HOURS;
    var inFlight = null;
    var requestSeq = 0;

    function normalizeMetrics(metrics) {
        if (!Array.isArray(metrics)) return [];
        return metrics.filter(function(m) { return m && m.ts; });
    }

    function formatTs(ts) {
        var d = new Date(ts);
        if (isNaN(d.getTime())) return '';
        if (hours >= 72) {
            return (d.getMonth() + 1) + '/' + d.getDate() + ' ' +
                pad2(d.getHours()) + ':' + pad2(d.getMinutes());
        }
        return pad2(d.getHours()) + ':' + pad2(d.getMinutes());
    }

    function pad2(n) { return String(n).padStart(2, '0'); }

    function fullTs(ts) {
        var d = new Date(ts);
        if (isNaN(d.getTime())) return '';
        return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate()) +
            ' ' + pad2(d.getHours()) + ':' + pad2(d.getMinutes()) + ':' +
            pad2(d.getSeconds());
    }

    function labelsFrom(metrics) {
        return metrics.map(function(m) { return formatTs(m.ts); });
    }

    function valuesFrom(metrics, key) {
        return metrics.map(function(m) {
            return m[key] == null ? null : m[key];
        });
    }

    var RANGE_LABELS = {
        1: '1 小时', 6: '6 小时', 24: '24 小时', 72: '3 天', 168: '7 天'
    };

    function rangeLabel(value) {
        return RANGE_LABELS[value] || (value + ' 小时');
    }

    // Live SSE samples keep arriving even with no stored history, so report the
    // absence of stored history instead of pretending the live points are one.
    function describeRange(totalCount, historyCount) {
        var name = rangeLabel(hours);
        if (!historyCount) {
            return '最近 ' + name + '内暂无历史数据，图表仅显示本次会话的实时采样。';
        }
        return '显示最近 ' + name + '（' + totalCount + ' 个采样点）';
    }

    function makeOptions() {
        return {
            responsive: true,
            maintainAspectRatio: false,
            resizeDelay: 120,
            interaction: { mode: 'index', intersect: false },
            plugins: {
                legend: { display: false },
                tooltip: {
                    enabled: true,
                    mode: 'index',
                    intersect: false,
                    callbacks: {
                        title: function(items) {
                            var idx = items.length ? items[0].dataIndex : -1;
                            var rows = currentRows();
                            return idx >= 0 && rows[idx] ? fullTs(rows[idx].ts) : '';
                        },
                    },
                },
            },
            scales: {
                y: {
                    min: 0,
                    max: 100,
                    ticks: { callback: function(v) { return v + '%'; } },
                },
                x: { ticks: { maxTicksLimit: 8, autoSkip: true } },
            },
            animation: { duration: 200 },
        };
    }

    function ensureChart(canvas, label, borderColor, backgroundColor) {
        if (!canvas) return null;
        var chart = Chart.getChart(canvas);
        if (chart) return chart;
        return new Chart(canvas, {
            type: 'line',
            data: {
                labels: [],
                datasets: [{
                    label: label,
                    data: [],
                    borderColor: borderColor,
                    backgroundColor: backgroundColor,
                    fill: true,
                    tension: 0.3,
                    pointRadius: 0,
                    pointHitRadius: 12,
                    spanGaps: true,
                }],
            },
            options: makeOptions(),
        });
    }

    function resizeCharts() {
        window.requestAnimationFrame(function() {
            if (cpuChart) cpuChart.resize();
            if (memChart) memChart.resize();
        });
    }

    // ── Status + error surface ──
    var statusEl = document.querySelector('[data-trend-status]');
    var errorEl = document.querySelector('[data-trend-error]');

    function setStatus(text) {
        if (statusEl) statusEl.textContent = text;
    }

    function setError(text) {
        if (!errorEl) return;
        if (text) {
            errorEl.textContent = text;
            errorEl.hidden = false;
        } else {
            errorEl.textContent = '';
            errorEl.hidden = true;
        }
    }

    // ── Render ──
    // The fetched window is kept whole; live samples accumulate beside it and
    // are capped separately so they can never trim the loaded history away.
    var historyRows = [];
    var liveRows = [];

    function currentRows() {
        return historyRows.concat(liveRows);
    }

    function renderRows() {
        var rows = currentRows();
        var labels = labelsFrom(rows);

        if (cpuChart) {
            cpuChart.data.labels = labels;
            cpuChart.data.datasets[0].data = valuesFrom(rows, 'cpu_percent');
            cpuChart.update('none');
        }
        if (memChart) {
            memChart.data.labels = labels;
            memChart.data.datasets[0].data = valuesFrom(rows, 'memory_percent');
            memChart.update('none');
        }
        resizeCharts();
        return rows.length;
    }

    function renderMetrics(metrics) {
        historyRows = normalizeMetrics(metrics);
        liveRows = [];
        var total = renderRows();
        setStatus(describeRange(total, historyRows.length));
    }

    function appendPoint(ts, cpu, mem) {
        liveRows.push({ ts: ts, cpu_percent: cpu, memory_percent: mem });
        while (liveRows.length > MAX_LIVE_POINTS) liveRows.shift();
        var total = renderRows();
        var text = describeRange(total, historyRows.length);
        setStatus(historyRows.length ? text + '，实时更新中' : text);
    }

    // ── Data loading ──
    // Every load carries a sequence number so a slow response for an abandoned
    // range cannot overwrite the range the user is actually looking at.
    function loadRange() {
        requestSeq += 1;
        var seq = requestSeq;
        var requestHours = hours;
        setError('');
        setStatus('正在加载最近 ' + rangeLabel(requestHours) + '…');
        return fetch(DATA_URL + '?hours=' + encodeURIComponent(requestHours), {
            headers: { Accept: 'application/json' },
            cache: 'no-store',
        })
            .then(function(response) {
                if (!response.ok) {
                    throw new Error('趋势数据请求失败 HTTP ' + response.status);
                }
                return response.json();
            })
            .then(function(metrics) {
                if (seq !== requestSeq) return;
                renderMetrics(metrics);
            })
            .catch(function(err) {
                if (seq !== requestSeq) return;
                setError('无法加载趋势数据，图表显示的是上一次成功加载的结果。');
                setStatus('趋势数据加载失败。');
                if (window.console && console.warn) {
                    console.warn('[RUOK] trend load failed', err);
                }
            });
    }

    function refreshHistory() {
        var request = loadRange();
        inFlight = request;
        var clear = function() {
            if (inFlight === request) inFlight = null;
        };
        request.then(clear, clear);
        return request;
    }

    function selectRange(nextHours) {
        hours = nextHours;
        // Abandon any in-flight load and clear immediately, so the chart never
        // shows the previous range's curve labelled as the new one.
        requestSeq += 1;
        historyRows = [];
        liveRows = [];
        updateRangeButtons();
        renderRows();
        refreshHistory();
    }

    function updateRangeButtons() {
        var buttons = document.querySelectorAll('[data-trend-hours]');
        Array.prototype.forEach.call(buttons, function(btn) {
            var value = Number(btn.getAttribute('data-trend-hours'));
            btn.setAttribute('aria-pressed', value === hours ? 'true' : 'false');
        });
    }

    cpuChart = ensureChart(
        cpuCanvas,
        'CPU %',
        '#667eea',
        'rgba(102,126,234,0.1)'
    );
    memChart = ensureChart(
        memCanvas,
        'Memory %',
        '#11998e',
        'rgba(17,153,142,0.1)'
    );
    window.ruokTrendCharts = { cpu: cpuChart, mem: memChart };

    // Paint whatever the server already rendered, so the panel is never blank
    // on first load, then load the selected range.
    renderMetrics(initialMetrics);
    updateRangeButtons();

    window.ruokTrendRangeListener = function(e) {
        var btn = e.target.closest && e.target.closest('[data-trend-hours]');
        if (!btn) return;
        var next = Number(btn.getAttribute('data-trend-hours'));
        if (!next || next === hours) return;
        selectRange(next);
    };
    document.addEventListener('click', window.ruokTrendRangeListener);

    window.ruokTrendMetricsListener = function(e) {
        var m = e.detail || {};
        appendPoint(new Date().toISOString(), m.cpu, m.mem_pct);
    };
    document.addEventListener('ruok:metrics', window.ruokTrendMetricsListener);

    window.ruokTrendResizeListener = resizeCharts;
    window.addEventListener('resize', window.ruokTrendResizeListener);
    // Refresh on the same cadence the status loop collects history points.
    window.ruokTrendRefreshTimer = window.setInterval(function() {
        // The panel can be replaced or removed; stop polling once it is gone.
        if (!cpuCanvas.isConnected) {
            window.clearInterval(window.ruokTrendRefreshTimer);
            return;
        }
        // Live samples already cover the newest minute; only refill the window
        // once the previous load has settled.
        if (!inFlight) refreshHistory();
    }, 60000);
    // Exposed so the dashboard can refetch once when the tab becomes visible.
    window.ruokTrendRefreshNow = refreshHistory;
})();
</script>
