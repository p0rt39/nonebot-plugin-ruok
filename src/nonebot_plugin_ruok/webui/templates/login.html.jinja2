<!DOCTYPE html>
<html lang="zh-CN" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>登录 — RuOK</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
    <style>
        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #e4ecf7 50%, #dce8f5 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-card {
            background: rgba(255,255,255,0.5);
            backdrop-filter: blur(16px) saturate(140%);
            -webkit-backdrop-filter: blur(16px) saturate(140%);
            border: 1px solid rgba(255,255,255,0.6);
            border-radius: 24px;
            box-shadow: 0 12px 32px rgba(0,0,0,0.1);
            padding: 2.5rem;
            width: 100%;
            max-width: 420px;
        }
        .login-card h2 {
            text-align: center;
            margin-bottom: 1.5rem;
        }
        .login-actions {
            display: flex;
            justify-content: center;
            gap: 0.75rem;
            margin-top: 1rem;
        }
    </style>
</head>
<body>
    <main class="container">
        <article class="login-card">
            <h2>🔐 RuOK WebUI</h2>
            {% if error %}
            <p style="color: var(--pico-del-color); text-align: center;">{{ error }}</p>
            {% endif %}
            {% if not admin_configured %}
            <p style="color: var(--pico-del-color); text-align: center;">
                未配置 <code>RUOK__WEBUI_ADMIN_PASSWORD</code>，WebUI 登录不可用。
            </p>
            {% endif %}
            <form method="post" action="/ruok/login">
                <label>
                    用户名
                    <input type="text" name="username" required autofocus
                           value="{{ username or '' }}" autocomplete="username"
                           placeholder="admin 或普通用户">
                </label>
                <label>
                    密码
                    <input type="password" name="password" required autocomplete="current-password"
                           placeholder="输入账户密码">
                </label>
                <button type="submit" style="width: 100%;" {% if not admin_configured %}disabled{% endif %}>登录</button>
            </form>
            <div class="login-actions">
                <a href="/ruok/register">注册普通用户</a>
            </div>
        </article>
    </main>
</body>
</html>
