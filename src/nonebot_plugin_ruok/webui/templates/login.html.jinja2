{% extends "_auth_shell.html.jinja2" %}
{% block title %}登录 — RuOK{% endblock %}
{% block subtitle %}登录后查看机器人健康状态与上报记录{% endblock %}

{% block content %}
{% if error %}
<p class="auth-alert" role="alert">{{ error }}</p>
{% endif %}
{% if not admin_configured %}
<p class="auth-alert" role="alert">
    未配置 <code>RUOK__WEBUI_ADMIN_PASSWORD</code>，WebUI 登录不可用。
</p>
{% endif %}
<form method="post" action="/ruok/login">
    <label>
        用户名
        <input type="text" name="username" required autofocus
               value="{{ username or '' }}" autocomplete="username"
               placeholder="admin 或普通用户"
               {% if error %}aria-invalid="true"{% endif %}>
    </label>
    <label class="password-field">
        密码
        <input id="login-password" type="password" name="password" required
               autocomplete="current-password" placeholder="输入账户密码"
               {% if error %}aria-invalid="true"{% endif %}>
        <button type="button" class="secondary outline password-toggle"
                data-password-toggle="login-password" aria-label="显示密码">
            显示
        </button>
    </label>
    <button type="submit" class="full-width" {% if not admin_configured %}disabled{% endif %}>
        登录
    </button>
</form>
<div class="auth-actions">
    <a href="/ruok/register">注册普通用户</a>
</div>
{% endblock %}
