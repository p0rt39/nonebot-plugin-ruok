{% extends "base.html.jinja2" %}
{% set active_page = "sessions" %}
{% block title %}Session: {{ session.session_id }}{% endblock %}

{% block head %}
<style>
    .detail-header {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex-wrap: wrap;
    }
    .detail-header__id {
        font-family: 'JetBrains Mono', 'Cascadia Code', 'Consolas', monospace;
    }
    .kv-table {
        margin-bottom: 0;
    }
    .kv-table th {
        width: 7rem;
        color: var(--ruok-text-muted);
        font-weight: 500;
        white-space: nowrap;
    }
    .kv-table td {
        overflow-wrap: anywhere;
    }
    .timeline {
        display: flex;
        flex-direction: column;
    }
    .timeline-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0;
        border-bottom: 1px solid var(--ruok-border);
    }
    .timeline-item:last-child {
        border-bottom: none;
    }
    .session-summary-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 0.6rem;
    }
    .session-summary-item {
        padding: 0.6rem 0.75rem;
        border: 1px solid var(--ruok-border);
        border-radius: var(--radius-sm);
        background: var(--ruok-surface-2);
    }
    .session-summary-item span {
        display: block;
        margin-bottom: 0.2rem;
        font-size: 0.82em;
        color: var(--ruok-text-muted);
    }
    .session-summary-item strong {
        overflow-wrap: anywhere;
    }
    .session-description-block,
    .session-traceback {
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        margin: 0;
        padding: 0.75rem;
        border-radius: var(--radius-sm);
        background: var(--ruok-surface-2);
        font-size: 0.85em;
    }
    .session-traceback {
        max-height: 480px;
        overflow: auto;
    }
    .session-traceback code {
        white-space: inherit;
        background: none;
        padding: 0;
    }
    /* Collapsible long content. Pico already draws the disclosure chevron on
       the summary, so only the layout and the trailing action need rules. */
    .detail-fold {
        margin: 0;
    }
    .detail-fold > summary {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
        font-weight: 600;
        color: var(--ruok-text-muted);
        font-size: 0.9em;
        margin-bottom: 0.4rem;
    }
    .detail-fold > summary > [data-copy-target] {
        margin: 0 0 0 auto;
    }
    .link-form {
        display: flex;
        gap: 0.5rem;
        margin-top: 0.75rem;
    }
    .link-form input, .link-form button {
        margin-bottom: 0;
    }
    .link-form button {
        width: auto;
        flex: none;
    }
</style>
{% endblock %}

{% block content %}

<div class="ruok-button-row" style="margin-bottom:0.9rem;">
    <a href="/ruok/sessions" role="button" class="secondary outline ruok-button-compact">← 返回 Session 列表</a>
</div>

{% include "_session_detail_content.html.jinja2" %}

{% endblock %}
