{% extends "_auth_shell.html.jinja2" %}
{% block title %}重设密码 — RuOK{% endblock %}
{% block subtitle %}使用绑定平台账号签发的一次性重置码{% endblock %}

{% block content %}
{% if error %}
<p class="auth-alert" role="alert">{{ error }}</p>
{% endif %}
{% if success %}
<p class="auth-success" role="status">{{ username }} 的密码已重设。</p>
<a href="/ruok/login" role="button" class="full-width" style="text-align:center;">返回登录</a>
{% else %}
<p>
    在已绑定的聊天账号中发送 <code>/ruok reset</code> 获取一次性重置码。
    群聊触发时，重置码只会通过私聊发送。
</p>
<form method="post" action="/ruok/reset-password" class="auth-form">
    <label class="auth-field">
        <span>重置码</span>
        <input type="text" name="reset_key" required autofocus
               value="{{ reset_key or '' }}" autocomplete="one-time-code"
               {% if error %}aria-invalid="true"{% endif %}>
    </label>
    <label class="auth-field password-field">
        <span>新密码</span>
        <span class="auth-input-wrap">
            <input id="reset-password" type="password" name="new_password" required
                   autocomplete="new-password" {% if error %}aria-invalid="true"{% endif %}>
            <button type="button" class="secondary outline password-toggle"
                    data-password-toggle="reset-password" aria-label="显示密码"
                    aria-pressed="false">
                <span class="password-toggle__icon" aria-hidden="true"></span>
            </button>
        </span>
    </label>
    <label class="auth-field password-field">
        <span>确认新密码</span>
        <span class="auth-input-wrap">
            <input id="reset-password-confirm" type="password" name="new_password_confirm"
                   required autocomplete="new-password"
                   {% if error %}aria-invalid="true"{% endif %}>
            <button type="button" class="secondary outline password-toggle"
                    data-password-toggle="reset-password-confirm" aria-label="显示密码"
                    aria-pressed="false">
                <span class="password-toggle__icon" aria-hidden="true"></span>
            </button>
        </span>
    </label>
    <button type="submit" class="full-width">重设密码</button>
</form>
{% endif %}
<div class="auth-actions">
    <a href="/ruok/login">返回登录</a>
</div>
{% endblock %}
