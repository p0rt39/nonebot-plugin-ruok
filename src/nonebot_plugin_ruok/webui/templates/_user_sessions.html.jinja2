<div id="my-sessions">
    <div class="results-count">
        共 {{ sessions | length }} 条我的上报
    </div>
    {% if sessions %}
    <div class="card-grid">
        {% for s in sessions %}
        <article class="animate-in">
            <header>
                <span class="status-dot status-{{ s.status }}" aria-hidden="true"></span>
                <strong>{{ s.session_id }}</strong>
                <small style="margin-left: auto;">
                    {{ s.first_seen_at.astimezone().strftime('%m-%d %H:%M') }}
                </small>
            </header>
            <p><strong>模块:</strong> {{ s.module_name }}</p>
            <p>
                <strong>状态:</strong>
                <span class="badge badge-{{ s.status | _status_tone }}">
                    {{ s.status | _status_label }}
                </span>
            </p>
            {% if s.reporter.user_id %}
            {% set reporter_label = reporter_display(s.reporter) if reporter_display is defined else s.reporter.user_id %}
            <p><small>上报者: {{ reporter_label }}</small></p>
            {% endif %}
            <p>{{ s.description | _session_summary }}</p>
        </article>
        {% endfor %}
    </div>
    {% else %}
    <article>
        <p>暂无上报记录。</p>
    </article>
    {% endif %}
</div>
