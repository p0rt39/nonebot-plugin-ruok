{% set current_rule = rule | default(none) %}
<details open style="margin-bottom:1.5rem;">
    <summary>{% if current_rule %}✏️ 编辑规则{% else %}➕ 添加规则{% endif %}</summary>
    <form hx-post="/ruok/_actions/notification-upsert"
          hx-target="#notifications-container"
          hx-swap="outerHTML"
          style="margin-top:1rem;">
        {% if current_rule %}
        <input type="hidden" name="original_name" value="{{ current_rule.name }}">
        <input type="hidden" name="return_to_detail" value="true">
        {% endif %}
        <div class="grid">
            <label>
                规则名称
                <input type="text" name="name" required
                       value="{{ current_rule.name if current_rule else '' }}"
                       placeholder="e.g. 紧急通知">
            </label>
            <label>
                冷却时间 (分钟)
                <input type="number" name="cooldown_minutes"
                       value="{{ current_rule.cooldown_minutes if current_rule else 60 }}"
                       min="1" step="1">
            </label>
        </div>
        <label>
            触发状态 (逗号分隔)
            <input type="text" name="on_status"
                   value="{{ current_rule.on_status | join(',') if current_rule else 'pending,unsolved' }}"
                   placeholder="pending, unsolved">
        </label>
        <fieldset>
            <legend>适用模块 (不选择=全部)</legend>
            {% if all_modules %}
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:0.35rem 0.75rem;max-height:240px;overflow:auto;padding:0.65rem;border:1px solid var(--pico-muted-border-color);border-radius:var(--radius-sm);">
                {% for m in all_modules %}
                <label style="display:flex;align-items:center;gap:0.45rem;margin:0;min-width:0;">
                    <input type="checkbox" name="selected_modules" value="{{ m.name }}"
                           {% if current_rule and m.name in current_rule.on_module %}checked{% endif %}>
                    <span style="overflow-wrap:anywhere;">{{ m.display_name or m.name }}</span>
                </label>
                {% endfor %}
            </div>
            {% else %}
            <input type="text" disabled value="暂无模块定义">
            {% endif %}
        </fieldset>
        <label>
            其他模块名 (逗号或换行分隔)
            <textarea name="on_module" rows="2"
                      placeholder="weather, music">{{ extra_modules | default([]) | join(',') }}</textarea>
        </label>
        <div class="grid">
            <label>
                通知通道 (逗号分隔)
                <input type="text" name="channels"
                       value="{{ current_rule.channels | join(',') if current_rule else 'bot_dm' }}"
                       placeholder="bot_dm, webhook">
            </label>
            <label>
                Webhook URL (可选)
                <input type="url" name="webhook_url"
                       value="{{ current_rule.webhook_url or '' if current_rule else '' }}"
                       placeholder="https://hooks.example.com/...">
            </label>
        </div>
        <label>
            <input type="checkbox" name="enabled"
                   {% if current_rule is none or current_rule.enabled %}checked{% endif %}>
            启用
        </label>
        <div class="ruok-button-row">
            <button type="submit" class="ruok-button">💾 保存规则</button>
            {% if current_rule %}
            <button type="button" class="outline secondary ruok-button"
                    hx-get="/ruok/_actions/notification-edit-form?{{ {'name': current_rule.name} | urlencode }}"
                    hx-target="closest details"
                    hx-swap="outerHTML">
                取消
            </button>
            {% endif %}
        </div>
    </form>
</details>
