<!-- SSE-refreshed partial: hero banner + system metrics + connections -->
<article class="hero-banner {% if status.overall == 'available' %}ok{% elif status.overall == 'degraded' %}warn{% else %}error{% endif %}">
    <div class="metric-value" style="color: #fff;">
        {% if status.overall == 'available' %}🟢 一切正常
        {% elif status.overall == 'degraded' %}🟡 部分降级
        {% else %}🔴 不可用
        {% endif %}
    </div>
    <div style="color: rgba(255,255,255,0.85); margin-top: 0.5rem;">
        {{ status.timestamp.strftime('%Y-%m-%d %H:%M:%S UTC') }}
        <small style="opacity:0.7; margin-left:1rem;">🔄 SSE</small>
    </div>
</article>

<h3>🖥️ 系统状态</h3>
<div class="card-grid" id="system-metrics">
    {% if status.bot and status.bot.checks %}
    {% for check in status.bot.checks %}
    <article>
        <header>
            <strong>{{ check.name }}</strong>
            <span class="badge badge-{% if check.status == 'healthy' %}ok{% elif check.status == 'degraded' %}warn{% else %}error{% endif %}">
                {{ check.status }}
            </span>
        </header>
        {% if check.message %}<p>{{ check.message }}</p>{% endif %}
        {% if check.details %}
        <details>
            <summary>详情</summary>
            <pre style="font-size:0.75em;"><code>{{ check.details | tojson(indent=2) }}</code></pre>
        </details>
        {% endif %}
    </article>
    {% endfor %}
    {% else %}<p>⏳ 系统数据采集中...</p>{% endif %}
</div>

<h3>🔗 连接状态</h3>
<div class="card-grid">
    {% for conn in status.connections %}
    <article>
        <header>
            <strong>{{ conn.self_id }}</strong>
            <span class="status-dot status-{{ 'available' if conn.connected else 'unavailable' }}"></span>
            {{ '在线' if conn.connected else '离线' }}
        </header>
        <p class="metric-label">适配器: {{ conn.adapter }}</p>
        {% if conn.latency_ms is not none %}<p class="metric-label">延迟: {{ '%.1f'|format(conn.latency_ms) }}ms</p>{% endif %}
        {% if conn.error %}<p style="color:var(--pico-del-color);">⚠️ {{ conn.error }}</p>{% endif %}
    </article>
    {% else %}<p>暂无连接</p>{% endfor %}
</div>
