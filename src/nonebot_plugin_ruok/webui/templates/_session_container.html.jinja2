<!-- Stats overview -->
<article style="padding: 1rem;">
    <div class="grid" style="text-align: center;">
        <div><span class="status-dot status-pending"></span> 待确认: <strong>{{ stats.pending }}</strong></div>
        <div><span class="status-dot status-unsolved"></span> 未解决: <strong>{{ stats.unsolved }}</strong></div>
        <div><span class="status-dot status-solved"></span> 已解决: <strong>{{ stats.solved }}</strong></div>
        <div><span class="status-dot status-ignored"></span> 已忽略: <strong>{{ stats.ignored }}</strong></div>
    </div>
</article>

<!-- Results count -->
<div class="results-count">
    共 {{ sessions | length }} 条结果
</div>

