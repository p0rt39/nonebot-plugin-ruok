{% extends "base.html.jinja2" %}
{% set active_page = "notifications" %}
{% block title %}通知规则{% endblock %}

{% block content %}

<h3>🔔 通知规则管理</h3>
<p>配置事件通知规则：哪些状态的 Session、哪些模块、通过什么渠道通知。</p>

<!-- Add / Edit Rule Form -->
<details style="margin-bottom: 1.5rem;">
    <summary>➕ 添加 / 编辑规则</summary>
    <form hx-post="/ruok/_actions/notification-upsert"
          hx-target="#notifications-container" hx-swap="outerHTML"
          style="margin-top: 1rem;">
        <div class="grid">
            <label>
                规则名称
                <input type="text" name="name" required placeholder="e.g. 紧急通知">
            </label>
            <label>
                冷却时间 (分钟)
                <input type="number" name="cooldown_minutes" value="60" min="1" step="1">
            </label>
        </div>
        <div class="grid">
            <label>
                触发状态 (逗号分隔)
                <input type="text" name="on_status" value="pending,unsolved"
                       placeholder="pending, unsolved">
            </label>
            <label>
                适用模块 (逗号分隔，留空=全部)
                <input type="text" name="on_module" placeholder="weather, music">
            </label>
        </div>
        <div class="grid">
            <label>
                通知通道 (逗号分隔)
                <input type="text" name="channels" value="bot_dm" placeholder="bot_dm, webhook">
            </label>
            <label>
                Webhook URL (可选)
                <input type="url" name="webhook_url" placeholder="https://hooks.example.com/...">
            </label>
        </div>
        <label>
            <input type="checkbox" name="enabled" checked> 启用
        </label>
        <button type="submit">💾 保存规则</button>
    </form>
</details>

<div id="notifications-container">
{% if rules %}
<div class="card-grid">
    {% for rule in rules %}
    <article>
        <header>
            <strong>{{ rule.name }}</strong>
            <span class="badge badge-{% if rule.enabled %}ok{% else %}error{% endif %}">
                {{ '启用' if rule.enabled else '禁用' }}
            </span>
        </header>
        <table>
            <tr>
                <td><strong>触发状态</strong></td>
                <td>
                    {% for s in rule.on_status %}
                    <span class="badge badge-{% if s == 'solved' %}ok{% elif s in ('pending','unsolved') %}warn{% else %}error{% endif %}">
                        {{ s }}
                    </span>
                    {% endfor %}
                </td>
            </tr>
            <tr>
                <td><strong>适用模块</strong></td>
                <td>{{ rule.on_module | join(', ') if rule.on_module else '全部' }}</td>
            </tr>
            <tr>
                <td><strong>冷却时间</strong></td>
                <td>{{ rule.cooldown_minutes }} 分钟</td>
            </tr>
            <tr>
                <td><strong>通道</strong></td>
                <td>{{ rule.channels | join(', ') }}</td>
            </tr>
            {% if rule.webhook_url %}
            <tr>
                <td><strong>Webhook</strong></td>
                <td><code>{{ rule.webhook_url[:50] }}{% if rule.webhook_url|length > 50 %}...{% endif %}</code></td>
            </tr>
            {% endif %}
        </table>
        <footer>
            <button class="outline secondary" style="font-size:0.8em;"
                    hx-post="/ruok/_actions/notification-delete/{{ rule.name }}"
                    hx-target="#notifications-container" hx-swap="outerHTML"
                    hx-confirm="确定删除规则「{{ rule.name }}」？">
                🗑️ 删除
            </button>
        </footer>
    </article>
    {% endfor %}
</div>
{% else %}
<article>
    <p>🎉 暂无通知规则。使用上方表单添加。</p>
</article>
{% endif %}
</div>

{% endblock %}
