<!-- SSE-refreshed partial: SVG gauges for CPU / Memory / Swap (~3s) -->
<h3>⚡ 系统资源</h3>

<div style="display:flex; gap:1.5rem; justify-content:center; flex-wrap:wrap;">
    {% for g in [
        {"id":"cpu","label":"CPU","pct":metrics.cpu_percent},
        {"id":"mem","label":"内存","pct":metrics.memory_percent},
        {"id":"swap","label":"Swap","pct":metrics.swap_percent},
    ] %}
    <article class="gauge-card" style="text-align:center; padding:1rem; min-width:150px;">
        <svg viewBox="0 0 120 120" style="width:120px;height:120px;">
            <circle cx="60" cy="60" r="50" fill="none"
                    stroke="rgba(0,0,0,0.08)" stroke-width="10"/>
            <circle cx="60" cy="60" r="50" fill="none"
                    stroke="{% if g.pct < 70 %}#2ecc40{% elif g.pct < 90 %}#ffdc00{% else %}#ff4136{% endif %}" stroke-width="10"
                    stroke-linecap="round"
                    stroke-dasharray="{{ (g.pct * 3.14159)|round(1) }} 314.159"
                    transform="rotate(-90 60 60)"
                    style="transition: stroke-dasharray 0.9s ease, stroke 0.9s ease;"/>
            <text x="60" y="55" text-anchor="middle" font-size="22" font-weight="700" fill="var(--pico-color)">{{ "%.0f"|format(g.pct) }}%</text>
            <text x="60" y="73" text-anchor="middle" font-size="11" fill="var(--pico-muted-color)">{{ g.label }}</text>
        </svg>
    </article>
    {% endfor %}
</div>

<!-- Memory detail row -->
<div style="text-align:center; font-size:0.8em; color:var(--pico-muted-color); margin-top:0.3rem;">
    内存: {{ metrics.memory_used|_fmt_bytes_s }} / {{ metrics.memory_total|_fmt_bytes_s }}
    {% if metrics.swap_total > 0 %} | Swap: {{ metrics.swap_used|_fmt_bytes_s }} / {{ metrics.swap_total|_fmt_bytes_s }}{% endif %}
</div>

{% if metrics.cpu_per_core|length > 1 %}
<div style="display:flex; gap:3px; justify-content:center; margin-top:0.5rem;">
    {% for core in metrics.cpu_per_core[:16] %}
    <span title="Core {{ loop.index0 }}: {{ '%.0f'|format(core) }}%"
          style="width:14px;height:14px;border-radius:2px;flex-shrink:0;
                 background:{% if core < 70 %}#2ecc40{% elif core < 90 %}#ffdc00{% else %}#ff4136{% endif %};
                 opacity:{{ 0.2 + core/150 }};"></span>
    {% endfor %}
</div>
{% endif %}

<script>
(function(){
    function c(v){ return v<70?'#2ecc40':v<90?'#ffdc00':'#ff4136'; }
    document.documentElement.style.setProperty('--gc-cpu', c({{ metrics.cpu_percent }}));
    document.documentElement.style.setProperty('--gc-mem', c({{ metrics.memory_percent }}));
    document.documentElement.style.setProperty('--gc-swap', c({{ metrics.swap_percent }}));
})();
</script>
<style>
    .gauge-card { background: var(--glass-bg) !important; backdrop-filter: blur(16px);
                  border: 1px solid var(--glass-border) !important; border-radius: var(--radius-md) !important;
                  box-shadow: var(--shadow-sm); }
</style>
