<!-- HTMX partial: auto-refreshing module status table -->
<div id="module-list">
{% if modules %}
<div class="table-scroll">
<table class="striped">
    <thead>
        <tr>
            <th>状态</th>
            <th>模块</th>
            <th>内部名</th>
            <th>插件数</th>
            <th>描述</th>
        </tr>
    </thead>
    <tbody>
        {% for m in modules %}
        <tr>
            <td class="cell-nowrap">
                <span class="badge badge-{{ m.status | _status_tone }}">{{ m.status | _status_label }}</span>
            </td>
            <td class="cell-name">
                <strong>
                    {% if module_links is defined and not module_links %}
                    {{ m.display_name or m.name }}
                    {% else %}
                    <a href="/ruok/modules/{{ m.name | urlencode }}">{{ m.display_name or m.name }}</a>
                    {% endif %}
                </strong>
            </td>
            <td class="cell-muted cell-name">{{ m.name }}</td>
            <td>{{ m.plugins | length }}</td>
            <td class="cell-desc">
                {{ m.description or '—' }}
                {% if m.status_reasons %}
                <br><small class="muted-text">{{ m.status_reasons[0] }}</small>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
</div>
{% else %}
<article>
    <p>暂无功能模块定义。使用 <code>PUT /ruok/api/modules/{name}</code> 或上方表单添加。</p>
</article>
{% endif %}
</div>
