<!-- HTMX partial: auto-refreshing module status table -->
<div id="module-list">
{% if modules %}
<table class="striped">
    <thead>
        <tr>
            <th>状态</th>
            <th>模块名</th>
            <th>显示名</th>
            <th>插件数</th>
            <th>描述</th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
        {% for m in modules %}
        <tr>
            <td>
                {% if m.status == 'available' %}🟢
                {% elif m.status == 'degraded' %}🟡
                {% elif m.status == 'unavailable' %}🔴
                {% else %}⚪{% endif %}
                {{ m.status }}
            </td>
            <td><strong><a href="/ruok/modules/{{ m.name | urlencode }}">{{ m.display_name or m.name }}</a></strong></td>
            <td>{{ m.display_name }}</td>
            <td>{{ m.plugins | length }}</td>
            <td>{{ m.description or '—' }}</td>
            <td>
                <div style="display:flex;gap:0.35rem;align-items:center;flex-wrap:wrap;">
                <button class="outline secondary" style="width:4.2rem;padding:2px 6px;font-size:0.78em;"
                        hx-get="/ruok/_actions/module-edit-form?{{ {'name': m.name} | urlencode }}"
                        hx-target="#module-form-panel"
                        hx-swap="innerHTML">
                    Edit
                </button>
                <form hx-post="/ruok/_actions/module-delete"
                      hx-target="#module-list"
                      hx-swap="outerHTML"
                      hx-confirm="确定删除模块「{{ m.display_name or m.name }}」？"
                      style="display:inline;margin:0;">
                    <input type="hidden" name="name" value="{{ m.name }}">
                    <button type="submit" class="outline secondary"
                            style="width:4.2rem;padding:2px 6px;font-size:0.78em;">
                        Del
                    </button>
                </form>
                </div>
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<article>
    <p>⚠️ 暂无功能模块定义。使用 <code>PUT /ruok/api/modules/{name}</code> 添加。</p>
</article>
{% endif %}
</div>
