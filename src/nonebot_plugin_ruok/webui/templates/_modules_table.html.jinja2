<!-- HTMX partial: auto-refreshing module status table -->
<div id="module-list">
{% if modules %}
<table class="striped">
    <thead>
        <tr>
            <th>状态</th>
            <th>模块名</th>
            <th>显示名</th>
            <th>插件数</th>
            <th>描述</th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
        {% for m in modules %}
        <tr>
            <td>
                {% if m.status == 'available' %}🟢
                {% elif m.status == 'degraded' %}🟡
                {% elif m.status == 'unavailable' %}🔴
                {% else %}⚪{% endif %}
                {{ m.status }}
            </td>
            <td><strong><a href="/ruok/modules/{{ m.name }}">{{ m.display_name or m.name }}</a></strong></td>
            <td>{{ m.display_name }}</td>
            <td>{{ m.plugins | length }}</td>
            <td>{{ m.description or '—' }}</td>
            <td>
                <button class="outline secondary" style="padding:2px 6px;font-size:0.78em;"
                        hx-get="/ruok/_actions/module-edit-form/{{ m.name }}"
                        hx-target="closest tr"
                        hx-swap="outerHTML">
                    Edit
                </button>
                <button class="outline secondary" style="padding:2px 6px;font-size:0.78em;"
                        hx-post="/ruok/_actions/module-delete/{{ m.name }}"
                        hx-target="#module-list"
                        hx-swap="outerHTML"
                        hx-confirm="确定删除模块「{{ m.display_name or m.name }}」？">
                    Del
                </button>
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<article>
    <p>⚠️ 暂无功能模块定义。使用 <code>PUT /ruok/api/modules/{name}</code> 添加。</p>
</article>
{% endif %}
</div>
