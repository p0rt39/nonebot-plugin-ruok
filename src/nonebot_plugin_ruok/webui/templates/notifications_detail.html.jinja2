{% extends "base.html.jinja2" %}
{% set active_page = "notifications" %}
{% block title %}{{ rule.name }} — 通知规则{% endblock %}

{% block content %}

<article class="hero-banner {{ 'ok' if rule.enabled else '' }}">
    <div class="status-bar__main">
        <strong class="status-bar__title">{{ rule.name }}</strong>
        <span class="badge badge-{{ 'ok' if rule.enabled else 'muted' }}">{{ '已启用' if rule.enabled else '已禁用' }}</span>
        <span class="status-bar__sub">冷却 {{ rule.cooldown_minutes | round(1) }} 分钟</span>
    </div>
    <dl class="user-meta">
        <div>
            <dt>触发状态</dt>
            <dd>
                {% for status in rule.on_status %}
                <span class="badge badge-{{ status | _status_tone }}">{{ status | _status_label }}</span>
                {% endfor %}
            </dd>
        </div>
        <div>
            <dt>适用模块</dt>
            <dd>{{ rule.on_module | join(', ') if rule.on_module else '全部' }}</dd>
        </div>
        <div>
            <dt>通知通道</dt>
            <dd>{{ rule.channels | join(', ') }}</dd>
        </div>
        {% if rule.webhook_url %}
        <div>
            <dt>Webhook</dt>
            <dd><code>{{ rule.webhook_url }}</code></dd>
        </div>
        {% endif %}
    </dl>
</article>

<div class="ruok-button-row" style="margin-bottom:0.9rem;">
    <a href="/ruok/notifications" role="button" class="secondary outline ruok-button-compact">← 返回规则列表</a>
    <form hx-post="/ruok/_actions/notification-delete"
          hx-target="body"
          hx-swap="none"
          hx-confirm="确定删除规则「{{ rule.name }}」？"
          style="margin:0;">
        <input type="hidden" name="name" value="{{ rule.name }}">
        <input type="hidden" name="redirect_to" value="/ruok/notifications">
        <button type="submit" class="secondary outline ruok-button-danger">删除规则</button>
    </form>
</div>

{% include "_notification_form.html.jinja2" %}

{% endblock %}
