{% extends "_auth_shell.html.jinja2" %}
{% block title %}注册 — RuOK{% endblock %}
{% block subtitle %}创建账号后用一次性绑定码连接聊天平台身份{% endblock %}

{% block content %}
{% if error %}
<p class="auth-alert" role="alert">{{ error }}</p>
{% endif %}
{% if not admin_configured %}
<p class="auth-alert" role="alert">
    未配置 <code>RUOK__WEBUI_ADMIN_PASSWORD</code>，注册暂不可用。
</p>
{% elif success %}
<p class="auth-success" role="status">账户已创建并登录。</p>
<p>一次性绑定码：</p>
<p class="auth-key"><code>{{ auth_key }}</code></p>
<p>
    在当前聊天平台中发送 <code>/ruok bind {{ auth_key }}</code> 完成绑定。
    {% if auth_key_expires_at %}有效期至 {{ auth_key_expires_at.astimezone().strftime('%Y-%m-%d %H:%M:%S') }}。{% endif %}
</p>
<a href="/ruok" role="button" class="full-width" style="text-align:center;">进入总览</a>
{% else %}
<form method="post" action="/ruok/register">
    <label>
        用户名
        <input type="text" name="username" required autofocus
               value="{{ username or '' }}" autocomplete="username"
               {% if error %}aria-invalid="true"{% endif %}>
    </label>
    <label class="password-field">
        密码
        <input id="register-password" type="password" name="password" required
               autocomplete="new-password" {% if error %}aria-invalid="true"{% endif %}>
        <button type="button" class="secondary outline password-toggle"
                data-password-toggle="register-password" aria-label="显示密码">
            显示
        </button>
    </label>
    <label class="password-field">
        确认密码
        <input id="register-password-confirm" type="password" name="password_confirm"
               required autocomplete="new-password"
               {% if error %}aria-invalid="true"{% endif %}>
        <button type="button" class="secondary outline password-toggle"
                data-password-toggle="register-password-confirm" aria-label="显示密码">
            显示
        </button>
    </label>
    <button type="submit" class="full-width">注册</button>
</form>
{% endif %}
<div class="auth-actions">
    <a href="/ruok/login">返回登录</a>
</div>
{% endblock %}
