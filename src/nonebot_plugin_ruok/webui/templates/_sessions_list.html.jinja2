<!-- HTMX partial: Session list (rows share _session_card.html.jinja2) -->
<div class="session-list">
{% if sessions %}
    <div class="session-row session-row--head" aria-hidden="true">
        <div>状态</div>
        <div>Session</div>
        <div>模块</div>
        <div>摘要</div>
        <div>最近发生</div>
        <div></div>
    </div>
    {% for s in sessions %}
    {% include "_session_card.html.jinja2" %}
    {% endfor %}
{% else %}
    <p class="session-list__empty">没有匹配的 Session。</p>
{% endif %}
</div>
