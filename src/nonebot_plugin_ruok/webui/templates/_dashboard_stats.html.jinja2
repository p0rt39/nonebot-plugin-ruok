<!-- Stats partial (innerHTML, no wrapper) -->
<h3>Session 统计</h3>
<div class="grid">
    <article>
        <canvas id="chart-sessions-pie" style="max-height: 220px;"></canvas>
    </article>
    <article>
        <table class="stats-table">
            <tr><td><span class="status-dot status-pending"></span>待确认</td><td><strong>{{ stats.pending }}</strong></td></tr>
            <tr><td><span class="status-dot status-unsolved"></span>未解决</td><td><strong>{{ stats.unsolved }}</strong></td></tr>
            <tr><td><span class="status-dot status-solved"></span>已解决</td><td><strong>{{ stats.solved }}</strong></td></tr>
            <tr><td><span class="status-dot status-ignored"></span>已忽略</td><td><strong>{{ stats.ignored }}</strong></td></tr>
            <tr><td><strong>总计</strong></td><td><strong>{{ stats.total }}</strong></td></tr>
        </table>
        <a href="/ruok/sessions" class="muted-text">查看全部 Sessions →</a>
    </article>
</div>
<script>
(function() {
    var data = [{{ stats.pending }}, {{ stats.unsolved }}, {{ stats.solved }}, {{ stats.ignored }}];
    var ctx = document.getElementById('chart-sessions-pie');
    if (!ctx) return;
    var chart = Chart.getChart(ctx);
    if (chart) {
        chart.data.datasets[0].data = data;
        chart.update('none');
    } else {
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['待确认', '未解决', '已解决', '已忽略'],
                datasets: [{
                    data: data,
                    backgroundColor: ['#d4a72c', '#e5534b', '#2da44e', '#9aa4ae'],
                    borderWidth: 0,
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                cutout: '65%',
                plugins: { legend: { position: 'bottom' } },
                animation: false,
            }
        });
    }
})();
</script>
