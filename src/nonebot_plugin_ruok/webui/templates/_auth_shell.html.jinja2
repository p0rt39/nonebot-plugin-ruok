<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Nonebot, RUOK?{% endblock %}</title>
    <script>
        (function(){var t=localStorage.getItem('ruok-theme')||'light';document.documentElement.setAttribute('data-theme',t);})();
    </script>
    <link rel="stylesheet" href="/ruok/static/vendor/pico/pico.min.css">
    <style>
        :root {
            --pico-font-size: 92%;
            --pico-border-radius: 6px;
            --auth-bg: #f3f5f7;
            --auth-surface: #ffffff;
            --auth-border: #dde1e6;
            --auth-muted: #5f6b7a;
            --auth-heading: #1f2328;
            --auth-danger: #c62828;
            --auth-danger-bg: #fde7e7;
            --auth-success: #1a7f37;
            --auth-success-bg: #dcf5e3;
            --auth-accent-soft: #e8f0fe;
            --radius-sm: 6px;
        }
        [data-theme="dark"] {
            --auth-bg: #0f1318;
            --auth-surface: #161b22;
            --auth-border: #2d3440;
            --auth-muted: #9aa5b1;
            --auth-heading: #e6edf3;
            --auth-danger: #ff7b72;
            --auth-danger-bg: rgba(248, 81, 73, 0.18);
            --auth-success: #56d364;
            --auth-success-bg: rgba(46, 160, 67, 0.18);
            --auth-accent-soft: rgba(56, 139, 253, 0.15);
        }
        body {
            min-height: 100vh;
            margin: 0;
            background: var(--auth-bg);
        }
        .auth-shell {
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 2rem 1rem;
        }
        .auth-panel {
            width: min(100%, 400px);
            background: var(--auth-surface);
            border: 1px solid var(--auth-border);
            border-radius: 8px;
            padding: 1.75rem;
        }
        .auth-brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 1.4rem;
        }
        .auth-mark {
            display: grid;
            width: 2.5rem;
            height: 2.5rem;
            flex: none;
            place-items: center;
            border-radius: 6px;
            background: var(--pico-primary-background);
            color: var(--pico-primary-inverse);
            font-weight: 700;
        }
        .auth-title {
            margin: 0;
            color: var(--auth-heading);
            font-size: 1.2rem;
            line-height: 1.2;
        }
        .auth-subtitle {
            margin: 0.15rem 0 0;
            color: var(--auth-muted);
            font-size: 0.88rem;
        }
        .auth-form {
            display: grid;
            gap: 0.85rem;
        }
        .auth-field {
            display: grid;
            gap: 0.3rem;
            margin: 0;
            color: var(--auth-heading);
            font-weight: 600;
        }
        .auth-field input {
            width: 100%;
            margin: 0;
        }
        .auth-input-wrap {
            position: relative;
            display: block;
        }
        .auth-alert {
            padding: 0.65rem 0.8rem;
            border-radius: var(--radius-sm);
            margin-bottom: 1rem;
            background: var(--auth-danger-bg);
            color: var(--auth-danger);
            border: 1px solid var(--auth-danger);
        }
        .auth-success {
            padding: 0.65rem 0.8rem;
            border-radius: var(--radius-sm);
            margin-bottom: 1rem;
            background: var(--auth-success-bg);
            color: var(--auth-success);
            border: 1px solid var(--auth-success);
        }
        .auth-key {
            overflow-wrap: anywhere;
            font-size: 0.96rem;
            padding: 0.7rem;
            border-radius: var(--radius-sm);
            background: var(--auth-accent-soft);
            border: 1px solid var(--auth-border);
        }
        .password-field input {
            padding-right: 3.2rem;
        }
        .password-field input::-ms-reveal,
        .password-field input::-ms-clear {
            display: none;
        }
        .password-field input::-webkit-credentials-auto-fill-button {
            visibility: hidden;
            pointer-events: none;
            position: absolute;
            right: 0;
        }
        .password-toggle {
            position: absolute;
            right: 0.4rem;
            top: 50%;
            transform: translateY(-50%);
            display: grid;
            place-items: center;
            width: auto;
            min-height: 0;
            padding: 0.15rem 0.45rem;
            margin: 0;
            font-size: 0.8rem;
            line-height: 1.4;
        }
        .password-toggle__icon::before {
            content: "显示";
        }
        .password-toggle[aria-pressed="true"] .password-toggle__icon::before {
            content: "隐藏";
        }
        button, [role="button"], input[type="submit"] {
            font-weight: 500;
        }
        .auth-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 0.75rem;
            margin-top: 1rem;
            flex-wrap: wrap;
            font-size: 0.9em;
        }
        .auth-actions a {
            white-space: nowrap;
        }
        .auth-options {
            display: flex;
            flex-wrap: wrap;
            gap: 0.4rem 1.2rem;
        }
        .auth-check {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            margin: 0;
            color: var(--auth-muted);
            font-weight: 500;
        }
        .auth-check input[type="checkbox"] {
            flex: none;
            width: 1.15em;
            height: 1.15em;
            margin: 0;
        }
        .full-width {
            width: 100%;
        }
        @media (max-width: 520px) {
            .auth-shell {
                padding: 1rem 0.75rem;
                align-items: start;
            }
            .auth-panel {
                padding: 1.25rem;
            }
        }
    </style>
</head>
<body>
    <main class="auth-shell">
        <section class="auth-panel auth-card">
            <div class="auth-brand">
                <div class="auth-mark">R</div>
                <div>
                    <h1 class="auth-title">Nonebot, RUOK?</h1>
                    <p class="auth-subtitle">{% block subtitle %}NoneBot 健康监控面板{% endblock %}</p>
                </div>
            </div>
            {% block content %}{% endblock %}
        </section>
    </main>
    <script>
    (function() {
        document.addEventListener('click', function(event) {
            var button = event.target.closest('[data-password-toggle]');
            if (!button) return;
            var field = document.getElementById(button.getAttribute('data-password-toggle'));
            if (!field) return;
            var visible = field.type === 'text';
            field.type = visible ? 'password' : 'text';
            button.setAttribute('aria-pressed', visible ? 'false' : 'true');
            button.setAttribute('aria-label', visible ? '显示密码' : '隐藏密码');
        });
    })();
    </script>
</body>
</html>
