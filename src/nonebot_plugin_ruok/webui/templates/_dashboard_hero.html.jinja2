<!-- Hero banner partial (innerHTML, no wrapper) -->
<article class="hero-banner {% if status.overall == 'available' %}ok{% elif status.overall == 'degraded' %}warn{% else %}error{% endif %}">
    <div style="font-size: 1.8em; font-weight: 700;">
        {% if status.overall == 'available' %}🟢 一切正常
        {% elif status.overall == 'degraded' %}🟡 部分降级
        {% else %}🔴 不可用
        {% endif %}
    </div>
    <div class="hero-ts" style="color: rgba(255,255,255,0.75); margin-top: 0.5rem; font-size:0.85em;">
        {{ status.timestamp.astimezone().strftime('%Y-%m-%d %H:%M:%S') }}
    </div>
    {% if status.status_reasons %}
    <ul style="margin-top: 0.75rem; margin-bottom: 0; padding-left: 1.2em; color: rgba(255,255,255,0.85); font-size: 0.85em;">
        {% for reason in status.status_reasons %}
        <li>{{ reason }}</li>
        {% endfor %}
    </ul>
    {% endif %}
</article>
