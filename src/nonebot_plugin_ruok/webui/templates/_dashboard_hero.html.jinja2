<!-- Overall status bar partial (innerHTML, no wrapper) -->
<article class="hero-banner {% if status.overall == 'available' %}ok{% elif status.overall == 'degraded' %}warn{% else %}error{% endif %}">
    <div class="status-bar__main">
        <span class="status-dot status-{{ status.overall }}"></span>
        <strong class="status-bar__title">
            {% if status.overall == 'available' %}一切正常
            {% elif status.overall == 'degraded' %}部分降级
            {% else %}不可用
            {% endif %}
        </strong>
        <span class="status-bar__ts hero-ts">{{ status.timestamp.astimezone().strftime('%Y-%m-%d %H:%M:%S') }}</span>
    </div>
    {% if status.status_reasons %}
    <ul class="status-bar__reasons">
        {% for reason in status.status_reasons %}
        <li>{{ reason }}</li>
        {% endfor %}
    </ul>
    {% endif %}
</article>
